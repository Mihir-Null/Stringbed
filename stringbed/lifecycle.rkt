#lang racket/base
(require racket/file racket/path racket/list racket/string racket/port json file/sha1
         "operations.rkt" (only-in "model.rkt" read-workspace workspace-text bytes-digest))
(provide prepare-plan read-plan apply-plan rollback-plan inspect-lifecycle
         lifecycle-status verify-plan encrypted-secret-metadata export-digest)
(define (sha data) (bytes->hex-string (sha256-bytes (open-input-bytes data))))
(define (file-sha p) (sha (file->bytes p)))
(define (canonical-data v)
  (cond [(hash? v) (for/list ([k (sort (hash-keys v) symbol<?)]) (list k (canonical-data (hash-ref v k))))]
        [(list? v) (map canonical-data v)] [else v]))
(define (digest-data v) (sha (string->bytes/utf-8 (format "~s" (canonical-data v)))))
(define (write-json-new path value)
  (call-with-output-file path (lambda (o) (write-json value o))))
(define (read-json-file p) (call-with-input-file p read-json))
(define (absolute p) (path->string (simplify-path (path->complete-path p))))
(define (export-digest dir)
  (define base (path->complete-path dir))
  (unless (and (file-exists? (build-path base "flake.nix")) (file-exists? (build-path base "flake.lock")))
    (error 'plan "a locked export is required"))
  (define paths (sort (for/list ([p (in-directory base)]) p) string<? #:key path->string))
  (for ([p paths]) (when (link-exists? p) (error 'plan "export symlinks are not accepted")))
  (digest-data (for/list ([p paths] #:when (file-exists? p))
                 (list (path->string (find-relative-path base p)) (file-sha p)))))
(define (store-path? p)
  (and (string? p) (regexp-match? #px"^/nix/store/[a-z0-9]{32}-[A-Za-z0-9+._?=-]+$" p)))
(define (require-store-path p)
  (unless (store-path? p) (error 'generation "expected a complete Nix store generation path")) p)
(define (profile-path kind home-profile)
  (case kind
    [(nixos) "/nix/var/nix/profiles/system"]
    [(home)
     (unless (and (string? home-profile) (absolute-path? home-profile)
                  (not (regexp-match? #rx"[\n\r\u0000]" home-profile)))
       (error 'profile "home activation requires an explicit absolute Home Manager profile path"))
     home-profile]
    [else (error 'profile "kind must be nixos or home")]))
(define (read-link target path)
  (string-trim (target-command target "readlink" (list "-f" "--" path))))
(define (inspect-lifecycle #:target [target #f] #:kind [kind 'nixos] #:home-profile [home-profile #f])
  (when target (validate-ssh-target target))
  (define profile (profile-path kind home-profile))
  (define selected (require-store-path (read-link target profile)))
  (define active (if (eq? kind 'nixos) (require-store-path (read-link target "/run/current-system")) selected))
  (hash 'schema 1 'state "observed" 'observed-at (current-seconds) 'target (or target "local")
        'kind (symbol->string kind) 'profile profile 'profile-generation selected 'active-generation active))
(define (plan-digest p) (digest-data (hash-remove p 'plan-id)))
(define (read-plan path)
  (define p (read-json-file path))
  (unless (and (hash? p) (equal? (hash-ref p 'schema #f) 1)
               (equal? (hash-ref p 'plan-id #f) (plan-digest p)))
    (error 'plan "invalid plan or changed plan content"))
  (unless (member (hash-ref p 'kind #f) '("nixos" "home")) (error 'plan "invalid adapter"))
  (for ([k '(closure previous-active previous-profile)]) (require-store-path (hash-ref p k)))
  (when (hash-ref p 'target #f) (validate-ssh-target (hash-ref p 'target)))
  p)
(define (verify-plan path)
  (define p (read-plan path))
  (unless (equal? (file-sha (hash-ref p 'source)) (hash-ref p 'source-sha256))
    (error 'plan "workspace source changed since planning"))
  (unless (equal? (export-digest (hash-ref p 'export)) (hash-ref p 'export-sha256))
    (error 'plan "export or lock changed since planning")) p)
(define (journal-path path) (string-append (absolute path) ".journal.json"))
(define (lifecycle-status path)
  (define p (read-plan path))
  (if (file-exists? (journal-path path))
      (let ([j (read-json-file (journal-path path))])
        (unless (equal? (hash-ref j 'plan-id #f) (hash-ref p 'plan-id)) (error 'journal "plan identity mismatch")) j)
      (hash 'schema 1 'plan-id (hash-ref p 'plan-id) 'state "built" 'events '())))
(define (record! path state [detail ""])
  (define old (lifecycle-status path))
  (define event (hash 'at (current-seconds) 'state state 'detail detail))
  (define next (hash-set* old 'state state 'events (append (hash-ref old 'events) (list event))))
  (define dest (journal-path path))
  (define tmp (make-temporary-file "stringbed-journal-~a" #f (path-only dest)))
  (dynamic-wind void
    (lambda ()
      (call-with-output-file tmp (lambda (o) (write-json next o)) #:exists 'truncate)
      (rename-file-or-directory tmp dest #t))
    (lambda () (when (file-exists? tmp) (delete-file tmp))))
  next)
(define (activation-entry kind closure)
  (string-append closure (if (equal? kind "nixos") "/bin/switch-to-configuration" "/activate")))
(define (check-entry target kind closure)
  (target-command target "test" (list "-x" (activation-entry kind closure)))
  (when (equal? kind "home")
    (define version-text (string-trim (target-command target "cat" (list "--" (string-append closure "/gen-version")))))
    (unless (and (regexp-match? #px"^[0-9]+$" version-text) (>= (string->number version-text) 1))
      (error 'activation "unsupported Home Manager generation version; driver version 1 is required"))))
(define (prepare-plan source export-dir plan-path #:target [target #f] #:build-host [build-host #f]
                      #:kind [kind 'nixos] #:home-profile [home-profile #f])
  (when target (validate-ssh-target target))
  (when build-host (validate-ssh-target build-host))
  (define profile (profile-path kind home-profile))
  (define source-path (absolute source))
  (define export-path (absolute export-dir))
  (when (or (file-exists? plan-path) (file-exists? (journal-path plan-path))
            (link-exists? (string-append (absolute plan-path) ".result"))
            (file-exists? (string-append (absolute plan-path) ".result"))) (error 'plan "plan destination exists"))
  (define source-hash (file-sha source-path))
  (define metadata (read-json-file (build-path export-path "target.json")))
  (unless (and (equal? (hash-ref metadata 'schema #f) 1)
               (equal? (hash-ref metadata 'target #f) (symbol->string kind))
               (member (hash-ref metadata 'system #f) '("x86_64-linux" "aarch64-linux")))
    (error 'plan "export target/system does not match the requested activation adapter"))
  (unless (equal? (bytes-digest (string->bytes/utf-8 (workspace-text (read-workspace source-path))))
                  (hash-ref metadata 'workspace-sha256 #f))
    (error 'plan "export was authored from a different workspace source"))
  (define export-hash (export-digest export-path))
  (define desired (hash 'source source-path 'source-sha256 source-hash 'export export-path 'export-sha256 export-hash))
  (define output
    ((current-runner) "nix"
      (append '("--extra-experimental-features" "nix-command flakes" "build" "--print-out-paths" "--no-update-lock-file")
              (list "--out-link" (string-append (absolute plan-path) ".result"))
              (if build-host (list "--builders" (string-append "ssh-ng://" build-host) "--max-jobs" "0") '())
              (list (string-append "path:" export-path "#packages." (hash-ref metadata 'system) ".default")))))
  (define closure (require-store-path (string-trim output)))
  (unless (and (equal? source-hash (file-sha source-path)) (equal? export-hash (export-digest export-path)))
    (error 'plan "source/export changed during build"))
  (check-entry #f (symbol->string kind) closure)
  (define observed (inspect-lifecycle #:target target #:kind kind #:home-profile home-profile))
  (check-entry target (symbol->string kind) (hash-ref observed 'active-generation))
  (define plan
    (hash-set* desired 'schema 1 'kind (symbol->string kind) 'target target 'build-host build-host
               'profile profile 'closure closure 'previous-active (hash-ref observed 'active-generation)
               'previous-profile (hash-ref observed 'profile-generation) 'created-at (current-seconds)
               'state "built" 'observed observed))
  (define with-id (hash-set plan 'plan-id (plan-digest plan)))
  (write-json-new plan-path with-id)
  (file-or-directory-permissions plan-path #o400)
  (record! plan-path "built" "Locked configuration built; activation has not run.")
  with-id)
(define (assert-generation p expected-active expected-profile)
  (define snap (inspect-lifecycle #:target (hash-ref p 'target)
                  #:kind (string->symbol (hash-ref p 'kind)) #:home-profile (hash-ref p 'profile)))
  (unless (and (equal? (hash-ref snap 'active-generation) expected-active)
               (equal? (hash-ref snap 'profile-generation) expected-profile))
    (error 'precondition "target generation changed; create a fresh plan or reconcile unknown state")))
(define current-mutation (make-parameter #f))
(define (activate p closure)
  (define target (hash-ref p 'target))
  (define profile (hash-ref p 'profile))
  (define nixos? (equal? (hash-ref p 'kind) "nixos"))
  ;; System profile selection and runtime activation are separate observable steps.
  ;; A disconnect between them is recorded as unknown and requires reconciliation.
  (when (current-mutation) (set-box! (current-mutation) #t))
  (target-command target (if nixos? "sudo" "nix-env")
                  (append (if nixos? '("-n" "nix-env") '()) (list "--profile" profile "--set" closure)))
  (target-command target (if nixos? "sudo" (string-append closure "/activate"))
                  (if nixos? (list "-n" (string-append closure "/bin/switch-to-configuration") "switch") '("--driver-version" "1"))))
(define (with-plan-lock path thunk)
  (define lock (string-append (absolute path) ".lock"))
  (make-directory lock)
  (dynamic-wind void thunk (lambda () (delete-directory lock))))
;; A target-side atomic directory serializes independent callers and plans.
;; Uncertain acquisition/release deliberately leaves a stale lock for inspection.
(define (with-target-lock p thunk)
  (define target (hash-ref p 'target))
  (define root? (equal? (hash-ref p 'kind) "nixos"))
  (define lock (string-append (hash-ref p 'profile) ".stringbed-lock"))
  (define (command name)
    (target-command target (if root? "sudo" name)
      (append (if root? (list "-n" name) '()) (list "--" lock))))
  (command "mkdir")
  (define completed? #f)
  (define mutation (box #f))
  (parameterize ([current-mutation mutation])
    (dynamic-wind void
      (lambda () (define result (thunk)) (set! completed? #t) result)
      (lambda () (when (or completed? (not (unbox mutation))) (command "rmdir"))))))
(define (apply-plan path)
  (with-plan-lock path
    (lambda ()
      (define p (verify-plan path))
      (unless (equal? (hash-ref (lifecycle-status path) 'state) "built")
        (error 'apply "plan is not awaiting activation; inspect its journal"))
      (with-target-lock p (lambda ()
      (assert-generation p (hash-ref p 'previous-active) (hash-ref p 'previous-profile))
      (define started? #f)
      (with-handlers ([exn:fail? (lambda (e)
                       (record! path (if started? "unknown" "failed") "Operation failed; process output is not retained.")
                       (raise e))])
        (when (hash-ref p 'target)
          ((current-runner) "nix" (list "--extra-experimental-features" "nix-command flakes" "copy" "--to"
                                       (string-append "ssh-ng://" (hash-ref p 'target)) (hash-ref p 'closure))))
        (assert-generation p (hash-ref p 'previous-active) (hash-ref p 'previous-profile))
        (check-entry (hash-ref p 'target) (hash-ref p 'kind) (hash-ref p 'closure))
        (record! path "activating" "Profile selection and activation requested.")
        (set! started? #t)
        (activate p (hash-ref p 'closure))
        (assert-generation p (hash-ref p 'closure) (hash-ref p 'closure))
        (record! path "activated" "Target generation verified.")))))))
(define (rollback-plan path)
  (with-plan-lock path
    (lambda ()
      ;; Recovery deliberately does not depend on the old source still existing.
      (define p (read-plan path))
      (unless (equal? (hash-ref (lifecycle-status path) 'state) "activated")
        (error 'rollback "only a verified activated plan can roll back automatically"))
      (with-target-lock p (lambda ()
      (assert-generation p (hash-ref p 'closure) (hash-ref p 'closure))
      (with-handlers ([exn:fail? (lambda (e) (when (unbox (current-mutation)) (record! path "unknown" "Rollback outcome unknown; inspect target before further action.")) (raise e))])
        (check-entry (hash-ref p 'target) (hash-ref p 'kind) (hash-ref p 'previous-active))
        (record! path "rolling-back" "Restoring prior generation.")
        (activate p (hash-ref p 'previous-active))
        ;; Preserve the previous selected profile if it differed from runtime.
        (unless (equal? (hash-ref p 'previous-active) (hash-ref p 'previous-profile))
          (target-command (hash-ref p 'target) "sudo"
            (list "-n" "nix-env" "--profile" (hash-ref p 'profile) "--set" (hash-ref p 'previous-profile))))
        (assert-generation p (hash-ref p 'previous-active) (hash-ref p 'previous-profile))
        (record! path "rolled-back" "Previous target generation verified.")))))))
;; This is metadata inspection only. No sops decryption is performed.
(define (encrypted-secret-metadata path)
  (define bytes (file->bytes path))
  (unless (and (regexp-match? #rx#"ENC\\[" bytes) (regexp-match? #rx#"sops" bytes))
    (error 'secret "file does not appear to contain a SOPS encrypted document"))
  (hash 'path (absolute path) 'sha256 (sha bytes) 'size (bytes-length bytes)
        'encrypted-document #t))
