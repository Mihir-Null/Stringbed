#lang racket/base
(require racket/file racket/list racket/port racket/pretty racket/string)
(provide read-workspace read-data workspace-valid! new-workspace node-by-id add-node update-node remove-node
         (struct-out session) open-session commit-edit! undo! save-session! workspace-text)
(define (read-data in)
  (parameterize ([read-accept-reader #f] [read-accept-lang #f] [read-accept-graph #f])
    (define d (read in))
    (unless (eof-object? (read in)) (error 'read "expected one datum")) d))
(define (new-workspace [name "workstation"] [target 'home])
  (hash 'schema 1 'name name 'target target 'system "x86_64-linux" 'user "demo"
        'home-directory "/home/demo" 'state-version "24.11"
        'inputs (hash 'nixpkgs "github:NixOS/nixpkgs/nixos-unstable"
                      'home-manager "github:nix-community/home-manager") 'nodes '()))
(define (workspace-valid! w)
  (unless (and (hash? w) (equal? (hash-ref w 'schema #f) 1)) (error 'workspace "unsupported schema"))
  (for ([k '(name system user home-directory state-version)])
    (unless (string? (hash-ref w k #f)) (error 'workspace "missing string ~a" k)))
  (unless (regexp-match? #px"^[A-Za-z][A-Za-z0-9_-]*$" (hash-ref w 'name)) (error 'workspace "invalid name"))
  (unless (member (hash-ref w 'target #f) '(home nixos)) (error 'workspace "target must be home or nixos"))
  (define inputs (hash-ref w 'inputs #f))
  (unless (and (hash? inputs) (hash-has-key? inputs 'nixpkgs)) (error 'workspace "nixpkgs input required"))
  (when (and (eq? (hash-ref w 'target) 'home) (not (hash-has-key? inputs 'home-manager))) (error 'workspace "home-manager input required"))
  (for ([(k v) (in-hash inputs)])
    (unless (and (symbol? k) (regexp-match? #px"^[A-Za-z][A-Za-z0-9_-]*$" (symbol->string k)) (string? v)) (error 'workspace "invalid input")))
  (define nodes (hash-ref w 'nodes #f))
  (unless (list? nodes) (error 'workspace "nodes must be a list"))
  (for ([n nodes])
    (unless (and (hash? n) (string? (hash-ref n 'id #f)) (symbol? (hash-ref n 'kind #f))
                 (hash? (hash-ref n 'params #f)) (string? (hash-ref n 'note #f))
                 (list? (hash-ref n 'docs #f)) (andmap string? (hash-ref n 'docs)))
      (error 'workspace "malformed node")))
  (unless (= (length nodes) (length (remove-duplicates (map (lambda (n) (hash-ref n 'id)) nodes)))) (error 'workspace "duplicate node IDs"))
  w)
(define (read-workspace path) (workspace-valid! (call-with-input-file path read-data)))
(define (workspace-text w) (with-output-to-string (lambda () (pretty-write w))))
(define (node-by-id w id)
  (or (findf (lambda (n) (equal? (hash-ref n 'id) id)) (hash-ref w 'nodes)) (error 'node "unknown ID ~a" id)))
(define (add-node w n)
  (workspace-valid! (hash-set w 'nodes (append (hash-ref w 'nodes) (list n)))))
(define (update-node w id f)
  (node-by-id w id)
  (workspace-valid! (hash-set w 'nodes (map (lambda (n) (if (equal? (hash-ref n 'id) id) (f n) n)) (hash-ref w 'nodes)))))
(define (remove-node w id)
  (node-by-id w id)
  (hash-set w 'nodes (filter (lambda (n) (not (equal? (hash-ref n 'id) id))) (hash-ref w 'nodes))))
(struct session (path workspace history baseline) #:mutable #:transparent)
(define (open-session path)
  (define baseline (file->bytes path))
  (session path (workspace-valid! (call-with-input-bytes baseline read-data)) '() baseline))
(define (commit-edit! s w)
  (workspace-valid! w)
  (set-session-history! s (cons (session-workspace s) (session-history s)))
  (set-session-workspace! s w))
(define (undo! s)
  (when (null? (session-history s)) (error 'undo "no edits to undo"))
  (set-session-workspace! s (car (session-history s)))
  (set-session-history! s (cdr (session-history s))))
(define (save-session! s)
  (define p (path->complete-path (session-path s)))
  (define lock (string->path (string-append (path->string p) ".lock")))
  (when (directory-exists? lock) (error 'save "workspace is locked"))
  (make-directory lock)
  (dynamic-wind void
    (lambda ()
      (unless (equal? (file->bytes p) (session-baseline s)) (error 'save "file changed externally; reopen before saving"))
      (define written (string->bytes/utf-8 (workspace-text (session-workspace s))))
      (define tmp (make-temporary-file "stringbed-~a" #f (path-only* p)))
      (dynamic-wind void
        (lambda ()
          (call-with-output-file tmp (lambda (o) (write-bytes written o)) #:exists 'truncate)
          (rename-file-or-directory tmp p #t)
          (set-session-baseline! s written))
        (lambda () (when (file-exists? tmp) (delete-file tmp)))))
    (lambda () (delete-directory lock))))
(define (path-only* p) (define-values (base name dir?) (split-path p)) base)
