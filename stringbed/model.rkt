#lang racket/base
(require racket/file racket/list racket/port racket/pretty racket/string racket/path
         file/sha1)
(provide read-workspace read-data workspace-valid! new-workspace node-by-id add-node update-node remove-node
         (struct-out session) open-session commit-edit! undo! save-session! workspace-text
         bytes-digest history-path source-backup-path workspace-lock-path call-with-workspace-lock atomic-write-bytes
         migrate-workspace! attach-generator-provenance)

;; Data readers never execute a #reader/#lang directive or accept graph cycles.
(define (read-data in)
  (parameterize ([read-accept-reader #f] [read-accept-lang #f] [read-accept-graph #f])
    (define d (read in))
    (unless (eof-object? (read in)) (error 'read "expected one datum")) d))
(define (bytes-digest bytes) (bytes->hex-string (sha256-bytes bytes)))
(define (new-workspace [name "workstation"] [target 'home])
  (hash 'schema 2 'name name 'target target 'system "x86_64-linux" 'user "demo"
        'home-directory "/home/demo" 'state-version "24.11"
        'provenance (hash 'kind 'authored)
        'inputs (hash 'nixpkgs "github:NixOS/nixpkgs/nixos-unstable"
                      'home-manager "github:nix-community/home-manager") 'nodes '()))
(define (workspace-valid! w)
  (unless (and (hash? w) (member (hash-ref w 'schema #f) '(1 2)))
    (error 'workspace "unsupported schema; supported schemas: 1, 2"))
  (for ([k '(name system user home-directory state-version)])
    (unless (string? (hash-ref w k #f)) (error 'workspace "missing string ~a" k)))
  (unless (regexp-match? #px"^[A-Za-z][A-Za-z0-9_-]*$" (hash-ref w 'name)) (error 'workspace "invalid name"))
  (unless (member (hash-ref w 'target #f) '(home nixos)) (error 'workspace "target must be home or nixos"))
  (when (= (hash-ref w 'schema) 2)
    (define provenance (hash-ref w 'provenance #f))
    (unless (and (hash? provenance) (symbol? (hash-ref provenance 'kind #f)))
      (error 'workspace "schema 2 requires provenance metadata")))
  (define inputs (hash-ref w 'inputs #f))
  (unless (and (hash? inputs) (hash-has-key? inputs 'nixpkgs)) (error 'workspace "nixpkgs input required"))
  (when (and (eq? (hash-ref w 'target) 'home) (not (hash-has-key? inputs 'home-manager))) (error 'workspace "home-manager input required"))
  (for ([(k v) (in-hash inputs)])
    (unless (and (symbol? k) (regexp-match? #px"^[A-Za-z][A-Za-z0-9_-]*$" (symbol->string k)) (string? v)) (error 'workspace "invalid input")))
  (define homes (hash-ref w 'homes (hash)))
  (unless (hash? homes) (error 'workspace "homes must be a hash"))
  (for ([(name settings) (in-hash homes)])
    (unless (and (symbol? name) (regexp-match? #px"^[A-Za-z_][A-Za-z0-9_-]*$" (symbol->string name))
                 (hash? settings) (string? (hash-ref settings 'home-directory #f))
                 (string? (hash-ref settings 'state-version #f)))
      (error 'workspace "invalid home metadata for ~s" name)))
  (define nodes (hash-ref w 'nodes #f))
  (unless (list? nodes) (error 'workspace "nodes must be a list"))
  (for ([n nodes])
    (unless (and (hash? n) (string? (hash-ref n 'id #f)) (symbol? (hash-ref n 'kind #f))
                 (hash? (hash-ref n 'params #f)) (string? (hash-ref n 'note #f))
                 (list? (hash-ref n 'docs #f)) (andmap string? (hash-ref n 'docs)))
      (error 'workspace "malformed node"))
    (when (hash-has-key? n 'scope)
      (define scope (hash-ref n 'scope))
      (unless (and (string? scope) (or (member scope '("system" "home"))
                                      (regexp-match? #px"^home:[A-Za-z_][A-Za-z0-9_-]*$" scope)))
        (error 'workspace "invalid node scope ~s" scope))))
  (unless (= (length nodes) (length (remove-duplicates (map (lambda (n) (hash-ref n 'id)) nodes)))) (error 'workspace "duplicate node IDs"))
  w)
(define (read-workspace path) (workspace-valid! (call-with-input-file path read-data)))
(define (workspace-text w) (with-output-to-string (lambda () (pretty-write w))))
(define (node-by-id w id)
  (or (findf (lambda (n) (equal? (hash-ref n 'id) id)) (hash-ref w 'nodes)) (error 'node "unknown ID ~a" id)))
(define (add-node w n)
  (workspace-valid! (hash-set w 'nodes (append (hash-ref w 'nodes) (list n)))))
(define (update-node w id f)
  (node-by-id w id)
  (workspace-valid! (hash-set w 'nodes (map (lambda (n) (if (equal? (hash-ref n 'id) id) (f n) n)) (hash-ref w 'nodes)))))
(define (remove-node w id)
  (node-by-id w id)
  (hash-set w 'nodes (filter (lambda (n) (not (equal? (hash-ref n 'id) id))) (hash-ref w 'nodes))))

;; The auto fields retain the original four-argument constructor API.
(struct session (path workspace history baseline [journal-baseline #:auto])
  #:auto-value #f #:mutable #:transparent)
(define (history-path path)
  (define p (path->complete-path path))
  (build-path (path-only p) ".stringbed" "history"
              (string-append (path->string (file-name-from-path p)) ".rktd")))
(define (workspace-lock-path path)
  (string->path (string-append (path->string (path->complete-path path)) ".lock")))
(define (optional-bytes p) (and (file-exists? p) (file->bytes p)))
(define (read-journal bytes)
  (define j (if bytes (call-with-input-bytes bytes read-data) (hash 'schema 1 'snapshots (hash))))
  (unless (and (hash? j) (equal? (hash-ref j 'schema #f) 1) (hash? (hash-ref j 'snapshots #f)))
    (error 'history "invalid history journal; preserve it and inspect before continuing"))
  (for ([(digest history) (in-hash (hash-ref j 'snapshots))])
    (unless (and (string? digest) (regexp-match? #px"^[0-9a-f]{64}$" digest) (list? history))
      (error 'history "invalid history snapshot"))
    (for-each workspace-valid! history))
  j)
(define (source-backup-path path digest)
  (unless (and (string? digest) (regexp-match? #px"^[a-f0-9]{64}$" digest))
    (error 'backup "invalid source digest"))
  (build-path (path-only (path->complete-path path)) ".stringbed" "sources" digest))
(define (open-session path)
  (define baseline (file->bytes path))
  (define journal-bytes (optional-bytes (history-path path)))
  (define j (read-journal journal-bytes))
  (define history (hash-ref (hash-ref j 'snapshots) (bytes-digest baseline) '()))
  ;; An externally edited source gets no stale undo chain. Its saved snapshots
  ;; remain on disk until the next successful save; source never comes from history.
  (define s (session path (workspace-valid! (call-with-input-bytes baseline read-data)) history baseline))
  (set-session-journal-baseline! s journal-bytes)
  s)
(define (commit-edit! s w)
  (workspace-valid! w)
  (unless (equal? w (session-workspace s))
    (set-session-history! s (cons (session-workspace s) (session-history s)))
    (set-session-workspace! s w)))
(define (undo! s)
  (when (null? (session-history s)) (error 'undo "no edits to undo"))
  (set-session-workspace! s (car (session-history s)))
  (set-session-history! s (cdr (session-history s))))
(define (call-with-workspace-lock path thunk)
  (define lock (workspace-lock-path path))
  ;; Exclusive mkdir is the lock acquisition; never adopt another writer's lock.
  (make-directory lock)
  (dynamic-wind void thunk (lambda () (delete-directory lock))))
(define (atomic-write-bytes p written)
  (define absolute (path->complete-path p))
  (define tmp (make-temporary-file "stringbed-~a" #f (path-only absolute)))
  (dynamic-wind void
    (lambda ()
      (call-with-output-file tmp (lambda (o) (write-bytes written o)) #:exists 'truncate)
      (rename-file-or-directory tmp absolute #t))
    (lambda () (when (file-exists? tmp) (delete-file tmp)))))
(define (save-session! s)
  (define p (path->complete-path (session-path s)))
  (call-with-workspace-lock p
    (lambda ()
      (define hp (history-path p))
      (unless (equal? (file->bytes p) (session-baseline s)) (error 'save "file changed externally; reopen before saving"))
      (unless (equal? (optional-bytes hp) (session-journal-baseline s))
        (error 'save "history changed externally; reopen before saving"))
      (define written (string->bytes/utf-8 (workspace-text (session-workspace s))))
      (define old-journal (read-journal (session-journal-baseline s)))
      (define old-digest (bytes-digest (session-baseline s)))
      (define new-digest (bytes-digest written))
      ;; Preserve every original byte before canonical serialization, including
      ;; datum comments and layout that are outside the structured note fields.
      (define backup (source-backup-path p old-digest))
      (make-directory* (path-only backup))
      (if (file-exists? backup)
          (unless (equal? (file->bytes backup) (session-baseline s))
            (error 'save "source backup integrity failure"))
          (atomic-write-bytes backup (session-baseline s)))
      ;; Keep the old source's undo chain and the new chain. Writing this before
      ;; source makes interruption recoverable at either source generation.
      (define snapshots
        (hash-set (hash old-digest (hash-ref (hash-ref old-journal 'snapshots) old-digest '()))
                  new-digest (session-history s)))
      (define journal-written (string->bytes/utf-8 (workspace-text (hash 'schema 1 'snapshots snapshots))))
      (make-directory* (path-only hp))
      (atomic-write-bytes hp journal-written)
      (set-session-journal-baseline! s journal-written)
      (atomic-write-bytes p written)
      (set-session-baseline! s written))))

(define (migrate-workspace! path)
  (define s (open-session path))
  (define w (session-workspace s))
  (cond
    [(= (hash-ref w 'schema) 2) path]
    [else
     (define backup (string->path (string-append (path->string (path->complete-path path)) ".v1.bak")))
     ;; The exact bytes are retained; no overwrite of an earlier migration backup.
     (call-with-output-file backup (lambda (o) (write-bytes (session-baseline s) o)))
     (commit-edit! s (hash-set* w 'schema 2 'provenance
                               (hash 'kind 'migrated 'from-schema 1
                                     'source-sha256 (bytes-digest (session-baseline s)))))
     (save-session! s)
     backup]))
(define (attach-generator-provenance w source-path)
  (define p (path->complete-path source-path))
  (workspace-valid!
   (hash-set* w 'schema 2 'provenance
              (hash 'kind 'generated 'source (path->string p)
                    'source-sha256 (bytes-digest (file->bytes p))))))
