#lang racket/base
(require racket/file racket/list racket/math racket/path racket/port racket/pretty
         racket/runtime-path racket/string json
         "extension.rkt" "compiler.rkt" "model.rkt" "durability.rkt"
         (prefix-in builtin: "builtins.rkt"))
(provide validate-builder-spec refresh-builder-builtins builder-spec->forms builder-expand preview-builder
         generate-builder-source save-builder-bundle! read-builder-bundle
         (struct-out exn:fail:builder))
(struct exn:fail:builder exn:fail (code field) #:transparent)
(define (bad code field fmt . args)
  (raise (exn:fail:builder (apply format fmt args) (current-continuation-marks) code field)))
(define-runtime-path builtin-file "builtins.rkt")
(define builtin-registry (make-registry builtin:forms))
(define (builtin-digest) (bytes-digest (file->bytes builtin-file)))
(define (object v field allowed)
  (unless (hash? v) (bad "invalid-spec" field "~a must be an object." field))
  (for ([key (hash-keys v)])
    (unless (member key allowed) (bad "unknown-field" field "Unknown ~a field: ~a." field key))) v)
(define (text h key [fallback #f] [field (symbol->string key)])
  (define v (hash-ref h key fallback))
  (unless (string? v) (bad "invalid-spec" field "~a must be a string." field)) v)
(define (identifier value field)
  (unless (and (string? value) (regexp-match? #px"^[A-Za-z_][A-Za-z0-9_-]*$" value))
    (bad "invalid-name" field "Use a name beginning with a letter or underscore, followed by letters, numbers, hyphens or underscores.")) value)
(define (digest value field)
  (unless (and (string? value) (regexp-match? #px"^[a-f0-9]{64}$" value))
    (bad "invalid-digest" field "~a must be a SHA-256 identity." field)) value)
(define (sequence h key)
  (define v (hash-ref h key '()))
  (unless (list? v) (bad "invalid-spec" (symbol->string key) "~a must be an array." key)) v)
(define (links h key)
  (for/list ([v (sequence h key)])
    (unless (and (string? v) (regexp-match? #px"^https?://[^[:space:]]+$" v))
      (bad "invalid-link" (symbol->string key) "Documentation and source links must be HTTP(S) URLs.")) v))
(define (json-data? v)
  (or (string? v) (boolean? v) (eq? v 'null)
      (and (real? v) (not (nan? v)) (not (infinite? v)) (or (exact-integer? v) (inexact? v)))
      (and (list? v) (andmap json-data? v))
      (and (hash? v) (for/and ([(k x) (in-hash v)]) (and (symbol? k) (json-data? x))))))
(define (data v field)
  (unless (json-data? v) (bad "invalid-value" field "Only JSON data values are accepted; code and Nix expressions are not values.")) v)
(define (relative-entry value)
  (unless (and (string? value) (positive? (string-length value)) (relative-path? value)
               (for/and ([part (explode-path value)]) (path? part)))
    (bad "invalid-source" "compositions.source.entry" "A dependency entry must be relative, without parent traversal.")) value)
(define (source-object source)
  (object source "compositions.source" '(kind sha256 entry))
  (define kind (text source 'kind))
  (cond [(equal? kind "builtin")
         (unless (= (hash-count source) 1) (bad "invalid-source" "compositions.source" "Builtin sources have only kind."))
         (hash 'kind "builtin")]
        [(equal? kind "bundle")
         (hash 'kind "bundle" 'sha256 (digest (hash-ref source 'sha256 #f) "compositions.source.sha256")
               'entry (relative-entry (hash-ref source 'entry #f)))]
        [else (bad "invalid-source" "compositions.source.kind" "Choose builtin or a captured bundle source.")]))
(define (binding value names field)
  (object value field '(literal parameter))
  (unless (= (hash-count value) 1) (bad "invalid-binding" field "Choose exactly one literal value or parameter binding."))
  (cond [(hash-has-key? value 'literal) (hash 'literal (data (hash-ref value 'literal) field))]
        [else
         (define name (text value 'parameter #f field))
         (unless (member name names) (bad "unknown-parameter" field "No declared parameter named ~a." name))
         (hash 'parameter name)]))
(define (literal-path value field)
  (define parts
    (cond [(string? value) (with-handlers ([exn:fail? (lambda (_) (bad "invalid-path" field "Use a dotted option path or an array of literal attribute names."))]) (attr-path value))]
          [else value]))
  (unless (and (pair? parts) (list? parts) (andmap (lambda (p) (and (string? p) (positive? (string-length p)))) parts))
    (bad "invalid-path" field "A definition needs a nonempty array of literal attribute names.")) parts)
(define (validate-default parameter)
  (define field-name (string->symbol (hash-ref parameter 'name)))
  (define d (form 'check "" (list (field field-name (string->symbol (hash-ref parameter 'type))
                                        (hash-ref parameter 'default) "")) (lambda (_p _w) '())))
  (with-handlers ([exn:fail? (lambda (e) (bad "invalid-default" (format "parameters.~a.default" field-name) "~a" (exn-message e)))])
    (validate-node (hash 'kind 'check 'params (hash field-name (hash-ref parameter 'default))) (hash 'check d))))
(define (validate-builder-spec spec)
  (object spec "spec" '(schema kind description parameters assignments compositions note docs sources builtinSha256))
  (unless (equal? (hash-ref spec 'schema #f) 1) (bad "unsupported-schema" "schema" "Builder schema 1 is required."))
  (define kind (identifier (hash-ref spec 'kind #f) "kind"))
  (when (hash-has-key? builtin-registry (string->symbol kind))
    (bad "reserved-kind" "kind" "Choose a form name other than the built-in ~a." kind))
  (define parameters
    (for/list ([p (sequence spec 'parameters)])
      (object p "parameters" '(name type default description))
      (define name (identifier (hash-ref p 'name #f) "parameters.name"))
      (define type (text p 'type))
      (unless (member type '("string" "boolean" "integer" "port" "attribute" "value"))
        (bad "invalid-type" "parameters.type" "Choose string, boolean, integer, port, attribute or value."))
      (unless (hash-has-key? p 'default) (bad "missing-default" (format "parameters.~a.default" name) "Choose a default for ~a." name))
      (define parameter (hash 'name name 'type type 'default (data (hash-ref p 'default) "parameters.default")
                              'description (text p 'description "")))
      (validate-default parameter) parameter))
  (define names (map (lambda (p) (hash-ref p 'name)) parameters))
  (unless (= (length names) (length (remove-duplicates names)))
    (bad "duplicate-parameter" "parameters.name" "Parameter names must be unique."))
  (define assignments
    (for/list ([a (sequence spec 'assignments)])
      (object a "assignments" '(path value))
      (hash 'path (literal-path (hash-ref a 'path #f) "assignments.path")
            'value (binding (hash-ref a 'value #f) names "assignments.value"))))
  (define compositions
    (for/list ([c (sequence spec 'compositions)])
      (object c "compositions" '(id kind source bindings))
      (define id (identifier (hash-ref c 'id #f) "compositions.id"))
      (define child-kind (identifier (hash-ref c 'kind #f) "compositions.kind"))
      (when (equal? child-kind kind) (bad "composition-cycle" "compositions.kind" "A builder form cannot compose itself."))
      (define bindings (hash-ref c 'bindings (hash)))
      (unless (hash? bindings) (bad "invalid-binding" "compositions.bindings" "Bindings must be an object keyed by child parameter name."))
      (hash 'id id 'kind child-kind 'source (source-object (hash-ref c 'source (hash 'kind "builtin")))
            'bindings (for/hash ([(key value) (in-hash bindings)])
                        (unless (symbol? key) (bad "invalid-binding" "compositions.bindings" "Binding keys must be names."))
                        (values key (binding value names (format "compositions.~a.bindings.~a" id key)))))))
  (for/fold ([sources-by-kind (hash)]) ([c compositions])
    (define key (hash-ref c 'kind)) (define source (hash-ref c 'source))
    (when (and (hash-has-key? sources-by-kind key) (not (equal? (hash-ref sources-by-kind key) source)))
      (bad "ambiguous-composition" "compositions.source" "Form ~a is selected from more than one source. Use one exact source per form kind." key))
    (hash-set sources-by-kind key source))
  (define ids (map (lambda (c) (hash-ref c 'id)) compositions))
  (unless (= (length ids) (length (remove-duplicates ids))) (bad "duplicate-composition" "compositions.id" "Composition IDs must be unique."))
  (define normalized
    (hash 'schema 1 'kind kind 'description (text spec 'description "")
          'parameters parameters 'assignments assignments 'compositions compositions
          'note (text spec 'note "") 'docs (links spec 'docs) 'sources (links spec 'sources)))
  (if (ormap (lambda (c) (equal? (hash-ref (hash-ref c 'source) 'kind) "builtin")) compositions)
      (hash-set normalized 'builtinSha256 (digest (hash-ref spec 'builtinSha256 (builtin-digest)) "builtinSha256"))
      normalized))
(define (refresh-builder-builtins input)
  ;; Explicit draft operation only. Captured dependency source identities stay put.
  (validate-builder-spec (hash-remove (validate-builder-spec input) 'builtinSha256)))
(define (check-builtins spec)
  (when (and (hash-has-key? spec 'builtinSha256) (not (equal? (hash-ref spec 'builtinSha256) (builtin-digest))))
    (bad "builtin-drift" "builtinSha256" "Built-in forms changed. Create an explicit derivative with a refreshed builtinSha256 before changing its meaning.")))
(define (resolve-binding binding values)
  (if (hash-has-key? binding 'literal) (hash-ref binding 'literal)
      (hash-ref values (string->symbol (hash-ref binding 'parameter)))))
(define (composition-form composition registry)
  (define kind (string->symbol (hash-ref composition 'kind)))
  (define source (hash-ref composition 'source))
  (define r (if (equal? (hash-ref source 'kind) "builtin") builtin-registry registry))
  (hash-ref r kind (lambda () (bad "unavailable-composition" "compositions.kind" "Load the captured source for form ~a before previewing this composition." kind))))
(define (builder-spec->forms input #:registry [registry builtin-registry])
  (define spec (validate-builder-spec input)) (check-builtins spec)
  (define kind (string->symbol (hash-ref spec 'kind)))
  (define descriptors
    (for/list ([p (hash-ref spec 'parameters)])
      (field (string->symbol (hash-ref p 'name)) (string->symbol (hash-ref p 'type))
             (hash-ref p 'default) (hash-ref p 'description))))
  (define children (for/list ([c (hash-ref spec 'compositions)]) (cons c (composition-form c registry))))
  (define parent-defaults (for/hash ([f descriptors]) (values (field-name f) (field-default f))))
  (for ([entry children])
    (define c (car entry)) (define d (cdr entry))
    (define child-values
      (for/fold ([p (defaults d)]) ([(key b) (in-hash (hash-ref c 'bindings))])
        (hash-set p key (resolve-binding b parent-defaults))))
    (with-handlers ([exn:fail? (lambda (e) (bad "invalid-composition" (format "compositions.~a.bindings" (hash-ref c 'id)) "~a" (exn-message e)))])
      (validate-node (hash 'kind (form-kind d) 'params child-values) (hash (form-kind d) d))))
  (list
   (form kind (hash-ref spec 'description) descriptors
     (lambda (values workspace)
       (append
        (for/list ([a (hash-ref spec 'assignments)]) (assignment (hash-ref a 'path) (resolve-binding (hash-ref a 'value) values)))
        (append-map
         (lambda (entry)
           (define c (car entry)) (define d (cdr entry))
           (define params (for/fold ([p (defaults d)]) ([(key b) (in-hash (hash-ref c 'bindings))])
                            (hash-set p key (resolve-binding b values))))
           (with-handlers ([exn:fail? (lambda (e) (bad "invalid-composition" (format "compositions.~a.bindings" (hash-ref c 'id)) "~a" (exn-message e)))])
             (validate-node (hash 'kind (form-kind d) 'params params) (hash (form-kind d) d))
             (define result ((form-expand d) params workspace))
             (unless (and (list? result) (andmap (lambda (x) (or (assignment? x) (nix-import? x))) result))
               (bad "invalid-expansion" "compositions" "Composed form ~a returned invalid definitions." (form-kind d))) result))
         children))))))
(define (builder-expand spec values workspace registry)
  (define d (car (builder-spec->forms spec #:registry registry)))
  (unless (hash? values) (bad "invalid-values" "values" "Sample parameter values must be an object."))
  (define params (for/fold ([p (defaults d)]) ([(key value) (in-hash values)]) (hash-set p key (data value "values"))))
  (with-handlers ([exn:fail:builder? raise]
                  [exn:fail? (lambda (e) (bad "invalid-values" "values" "~a" (exn-message e)))])
    (validate-node (hash 'kind (form-kind d) 'params params) (hash (form-kind d) d))
    ((form-expand d) params workspace)))

;; Construct code from data syntax; no UI-provided text is read or evaluated.
(define (datum-expression value)
  (cond [(hash? value) `(hash ,@(append-map (lambda (key) (list `(quote ,key) (datum-expression (hash-ref value key))))
                                         (sort (hash-keys value) symbol<?)))]
        [(list? value) `(list ,@(map datum-expression value))]
        [(symbol? value) `(quote ,value)] [else value]))
(define (dependency-sources spec)
  (sort (remove-duplicates (for/list ([c (hash-ref spec 'compositions)]
                                    #:when (equal? (hash-ref (hash-ref c 'source) 'kind) "bundle")) (hash-ref c 'source)))
        string<? #:key (lambda (s) (string-append (hash-ref s 'sha256) "/" (hash-ref s 'entry)))))
(define (binding-expression b)
  (if (hash-has-key? b 'literal) (datum-expression (hash-ref b 'literal))
      `(hash-ref params (quote ,(string->symbol (hash-ref b 'parameter))))))
(define (generate-builder-source input)
  (define spec (validate-builder-spec input))
  (define deps (dependency-sources spec))
  (define (prefix source)
    (if (equal? (hash-ref source 'kind) "builtin") 'builtin:
        (string->symbol (format "dependency~a:" (index-of deps source)))))
  (define forms
    (append
     (list '(provide forms builder-spec)
           `(define builder-spec ,(datum-expression spec)))
     (if (hash-has-key? spec 'builtinSha256)
         (list
          `(unless (equal? ,(hash-ref spec 'builtinSha256)
                           (bytes->hex-string
                            (sha256-bytes
                             (file->bytes (resolved-module-path-name
                                           (module-path-index-resolve (module-path-index-join 'stringbed/builtins #f)))))))
             (error 'builder "Built-in forms changed; generate an explicit derivative before changing this module's meaning."))) '())
     (list
      `(define forms
         (list
          (form (quote ,(string->symbol (hash-ref spec 'kind))) ,(hash-ref spec 'description)
                (list ,@(for/list ([p (hash-ref spec 'parameters)])
                          `(field (quote ,(string->symbol (hash-ref p 'name))) (quote ,(string->symbol (hash-ref p 'type)))
                                  ,(datum-expression (hash-ref p 'default)) ,(hash-ref p 'description))))
                (lambda (params workspace)
                  (append
                   (list ,@(for/list ([a (hash-ref spec 'assignments)])
                             `(assignment (quote ,(hash-ref a 'path)) ,(binding-expression (hash-ref a 'value)))))
                   ,@(for/list ([c (hash-ref spec 'compositions)])
                       (define child-kind (string->symbol (hash-ref c 'kind)))
                       (define exported-forms (string->symbol (string-append (symbol->string (prefix (hash-ref c 'source))) "forms")))
                       `(let* ([descriptor (or (findf (lambda (f) (eq? (form-kind f) (quote ,child-kind))) ,exported-forms)
                                               (error 'builder ,(format "Captured source no longer exports ~a." child-kind)))]
                               [bound (for/fold ([values (defaults descriptor)])
                                                ([(key value) (in-hash (hash ,@(append-map
                                                  (lambda (key) (list `(quote ,key) (binding-expression (hash-ref (hash-ref c 'bindings) key))))
                                                  (sort (hash-keys (hash-ref c 'bindings)) symbol<?))))])
                                        (hash-set values key value))])
                          (validate-node (hash 'kind (quote ,child-kind) 'params bound) (hash (quote ,child-kind) descriptor))
                          ((form-expand descriptor) bound workspace)))))))))))
  (define requires
    `(require racket/list stringbed/extension
              ,@(if (hash-has-key? spec 'builtinSha256) '(racket/file file/sha1 (prefix-in builtin: stringbed/builtins)) '())
              ,@(for/list ([source deps])
                  `(prefix-in ,(prefix source) ,(string-append "dependencies/" (hash-ref source 'sha256) "/" (hash-ref source 'entry))))))
  (string-append "#lang racket/base\n;; Generated from builder.json; hand edits detach this file from visual editing.\n"
                 (with-output-to-string (lambda () (for ([form (cons requires forms)]) (pretty-write form))))))
(define (definition-view definition)
  (cond [(assignment? definition)
         (define value (assignment-value definition))
         (define expression (nix-value value))
         (hash 'kind "assignment" 'path (assignment-path definition)
               'value (if (json-data? value) value (hash 'unavailable "trusted Nix expression" 'nix expression))
               'text (format "~a = ~a;" (string-join (map nix-string (assignment-path definition)) ".") expression))]
        [else (hash 'kind "import" 'expression (nix-import-expression definition)
                    'text (format "imports = [ ~a ];" (nix-import-expression definition)))]))
(define (preview-builder spec values workspace registry)
  (define normalized (validate-builder-spec spec))
  (hash 'spec normalized 'racket (generate-builder-source normalized)
        'definitions (map definition-view (builder-expand normalized values workspace registry))
        'validation "structural-only" 'diagnostics '()))

(define (canonical-json value)
  (cond [(hash? value)
         (string-append "{" (string-join
                            (for/list ([key (sort (hash-keys value) symbol<?)])
                              (string-append (jsexpr->string (symbol->string key)) ":" (canonical-json (hash-ref value key)))) ",") "}")]
        [(list? value) (string-append "[" (string-join (map canonical-json value) ",") "]")]
        [else (jsexpr->string value)]))
(define (json-bytes value) (string->bytes/utf-8 (string-append (canonical-json value) "\n")))
(define (json-file path)
  (call-with-input-file path
    (lambda (in)
      (define value (read-json in))
      (unless (eof-object? (read-json in)) (bad "invalid-builder-file" "directory" "Expected one JSON object in ~a." path)) value)))
(define (complete path) (simplify-path (path->complete-path path) #f))
(define (reject-symlink-ancestors path)
  (for/fold ([prefix #f]) ([part (explode-path (complete path))])
    (define next (if prefix (build-path prefix part) part))
    (when (link-exists? next) (bad "unsafe-path" "directory" "Builder directories cannot traverse symlinks: ~a." next)) next))
(define (immutable-directory? path)
  (regexp-match? #px"(?:^|/)\\.stringbed/extensions(?:/|$)" (path->string (complete path))))
(define (recovery-path directory) (string->path (string-append (path->string directory) ".builder-recovery.json")))
(define (read-builder-bundle path)
  (define directory (complete path))
  (reject-symlink-ancestors directory)
  (unless (directory-exists? directory) (bad "missing-builder" "directory" "No builder directory at ~a." directory))
  (for ([name '("builder.json" "main.rkt" "builder.lock.json")])
    (unless (file-exists? (build-path directory name))
      (bad "not-builder-generated" "directory" "This is not a visual-builder bundle: ~a is missing. Arbitrary Racket is never reconstructed as a builder spec." name)))
  (define identity (bundle-identity directory))
  (define receipt (json-file (build-path directory "builder.lock.json")))
  (unless (and (hash? receipt) (equal? (hash-ref receipt 'schema #f) 1) (equal? (hash-ref receipt 'generator #f) 1))
    (bad "unsupported-generator" "directory" "Unsupported builder generation receipt."))
  (define raw-spec (file->bytes (build-path directory "builder.json")))
  (define source (file->bytes (build-path directory "main.rkt")))
  (unless (equal? (bytes-digest raw-spec) (hash-ref receipt 'specSha256 #f))
    (bad "spec-drift" "directory" "builder.json changed outside the builder. Preserve it and explicitly reconcile the spec before visual editing."))
  (define spec (validate-builder-spec (json-file (build-path directory "builder.json"))))
  (unless (and (equal? (bytes-digest source) (hash-ref receipt 'sourceSha256 #f))
               (equal? source (string->bytes/utf-8 (generate-builder-source spec))))
    (bad "source-drift" "directory" "main.rkt was edited by hand or generated by a different builder. Visual save is refused; preserve the Racket implementation or create a separate new module."))
  (define declared (dependency-sources spec))
  (unless (equal? (canonical-json declared) (canonical-json (hash-ref receipt 'dependencies '())))
    (bad "dependency-drift" "directory" "The dependency receipt does not match the spec."))
  (define roots
    (for/hash ([source declared])
      (define sha (hash-ref source 'sha256))
      (define root (build-path directory "dependencies" sha))
      (unless (and (directory-exists? root) (equal? (hash-ref (bundle-identity root) 'sha256) sha)
                   (file-exists? (build-path root (hash-ref source 'entry))))
        (bad "dependency-drift" "compositions.source" "Captured dependency ~a is missing or changed." sha))
      (values sha (path->string root))))
  (hash 'spec spec 'directory (path->string directory) 'entry "main.rkt"
        'sourceSha256 (bytes-digest source) 'revision (hash-ref identity 'sha256)
        'dependencies roots 'editable (not (immutable-directory? directory))
        'builtinsCompatible (or (not (hash-has-key? spec 'builtinSha256))
                               (equal? (hash-ref spec 'builtinSha256) (builtin-digest)))))
(define (copy-verified-directory source destination expected)
  (define identity (bundle-identity source))
  (unless (equal? (hash-ref identity 'sha256) expected)
    (bad "dependency-drift" "compositions.source" "A source bundle changed before capture."))
  (make-directory* destination)
  (for ([entry (hash-ref identity 'files)])
    (define target (build-path destination (car entry)))
    (make-directory* (path-only target))
    (copy-file (build-path source (car entry)) target #t))
  (unless (and (equal? (hash-ref (bundle-identity source) 'sha256) expected)
               (equal? (hash-ref (bundle-identity destination) 'sha256) expected))
    (bad "dependency-drift" "compositions.source" "A bundle changed while being copied; no edited module was adopted.")))
(define (save-builder-bundle! input path #:dependencies [dependency-roots (hash)]
                              #:source-directory [source-directory #f] #:expected-revision [expected #f]
                              #:registry [registry builtin-registry])
  (define spec (validate-builder-spec input))
  (builder-spec->forms spec #:registry registry)
  (define directory (complete path))
  (reject-symlink-ancestors directory)
  (when (immutable-directory? directory)
    (bad "immutable-snapshot" "directory" "Pinned snapshots are immutable. Save a working derivative outside .stringbed/extensions, then explicitly repin it."))
  (when (file-exists? directory) (bad "invalid-directory" "directory" "The destination is a file."))
  (define parent (path-only directory))
  (make-directory* parent)
  (when (file-exists? (recovery-path directory))
    (bad "recovery-required" "directory" "A previous save has a recovery receipt at ~a. Inspect its staged/backup paths before continuing." (recovery-path directory)))
  (call-with-workspace-lock directory
    (lambda ()
      (define previous (and (directory-exists? directory) (read-builder-bundle directory)))
      (when previous
        (unless (and (string? expected) (equal? expected (hash-ref previous 'revision)))
          (bad "stale-builder" "expectedRevision" "This builder directory changed or was not reopened. Reload it before saving; no files were overwritten.")))
      (when (and (not previous) expected)
        (bad "stale-builder" "expectedRevision" "The previously opened builder directory is missing."))
      (define original (and source-directory (read-builder-bundle source-directory)))
      (define roots
        (for/fold ([r dependency-roots]) ([record (filter values (list previous original))])
          (for/fold ([out r]) ([(sha root) (in-hash (hash-ref record 'dependencies))])
            (if (hash-has-key? out sha) out (hash-set out sha root)))))
      (define stage (make-temporary-file "stringbed-builder-stage-~a" 'directory parent))
      (define backup #f)
      (define adopted? #f)
      (dynamic-wind void
        (lambda ()
          (when previous (copy-verified-directory directory stage (hash-ref previous 'revision)))
          ;; Preserve unknown files and no-longer-used captured dependencies. The
          ;; builder only replaces its three managed projections and adds bundles.
          (for ([source (dependency-sources spec)])
            (define sha (hash-ref source 'sha256))
            (define target (build-path stage "dependencies" sha))
            (cond
              [(directory-exists? target)
               (unless (equal? (hash-ref (bundle-identity target) 'sha256) sha)
                 (bad "dependency-drift" "compositions.source" "An existing captured dependency changed."))]
              [else
               (define root (hash-ref roots sha (lambda () (bad "missing-dependency" "compositions.source" "Load or retain captured dependency ~a before saving." sha))))
               (copy-verified-directory root target sha)])
            (unless (file-exists? (build-path target (hash-ref source 'entry)))
              (bad "missing-dependency" "compositions.source.entry" "The captured dependency entry is missing.")))
          (define spec-bytes (json-bytes spec))
          (define source-bytes (string->bytes/utf-8 (generate-builder-source spec)))
          (atomic-write-bytes (build-path stage "builder.json") spec-bytes)
          (atomic-write-bytes (build-path stage "main.rkt") source-bytes)
          (atomic-write-bytes
           (build-path stage "builder.lock.json")
           (json-bytes (hash 'schema 1 'generator 1 'specSha256 (bytes-digest spec-bytes)
                             'sourceSha256 (bytes-digest source-bytes) 'dependencies (dependency-sources spec))))
          (read-builder-bundle stage)
          (when previous
            (unless (equal? (hash-ref (bundle-identity directory) 'sha256) expected)
              (bad "stale-builder" "expectedRevision" "The working directory changed during save; nothing was replaced."))
            (set! backup (make-temporary-file "stringbed-builder-backup-~a" 'directory parent))
            (delete-directory backup)
            (atomic-write-bytes (recovery-path directory)
              (json-bytes (hash 'directory (path->string directory) 'backup (path->string backup)
                                'stage (path->string stage) 'expectedRevision expected)))
            (rename-file-or-directory directory backup))
          (with-handlers ([exn:fail?
                           (lambda (e)
                             (when (and backup (directory-exists? backup) (not (directory-exists? directory)))
                               (rename-file-or-directory backup directory)
                               (when (file-exists? (recovery-path directory)) (delete-file (recovery-path directory))))
                             (raise e))])
            (rename-file-or-directory stage directory)
            (set! adopted? #t))
          (when (file-exists? (recovery-path directory)) (delete-file (recovery-path directory))))
        (lambda ()
          ;; A break also restores the previous directory if it interrupted the
          ;; two-rename swap. If recovery cannot complete, retain the receipt.
          (when (and backup (directory-exists? backup) (not (directory-exists? directory)))
            (with-handlers ([exn:fail? void])
              (rename-file-or-directory backup directory)
              (when (file-exists? (recovery-path directory)) (delete-file (recovery-path directory)))))
          (when (and (not adopted?) (directory-exists? stage)) (delete-directory/files stage))))
      (hash-set (read-builder-bundle directory) 'backupDirectory
                (if (and backup (directory-exists? backup)) (path->string backup) 'null)))))
