;;; stringbed.el --- Inspect and author Nix workspaces -*- lexical-binding: t; -*-

;; Version: 0.3.0
;; Package-Requires: ((emacs "28.1") (magit-section "3.3.0"))
;; Keywords: tools, convenience
;; URL: https://github.com/Mihir-Null/Stringbed

;;; Commentary:
;; M-x stringbed-open opens an existing workspace.  Racket owns persistence,
;; expansion, discovery and validation.  This package renders its JSON protocol.
;; The backend command must name the same Stringbed revision as this package.

;;; Code:
(require 'cl-lib)
(require 'json)
(require 'subr-x)
(require 'button)
(require 'widget)
(require 'wid-edit)
(require 'tabulated-list)
(require 'magit-section)
(require 'browse-url)
(declare-function magit-status "magit" (directory &optional cache))

(defgroup stringbed nil "Author declarative workspaces." :group 'tools)
(defcustom stringbed-command '("stringbed" "serve")
  "Backend program and arguments.  Values are passed without a shell."
  :type '(repeat string))
(defcustom stringbed-confirm-trusted-code t
  "Ask once before opening a workspace with executable extensions.
Choose data-only inspection at this prompt to avoid executing workspace code."
  :type 'boolean)
(defface stringbed-title '((t :inherit font-lock-function-name-face :weight bold)) "Workspace title.")
(defface stringbed-muted '((t :inherit shadow)) "Supporting text.")

(cl-defstruct (stringbed--connection (:constructor stringbed--make-connection))
  process session (revision 0) (counter 0) (pending (make-hash-table :test #'equal))
  (fragment "") workspace forms path root buffers (status "Opening") timer mutation)
(defvar-local stringbed--connection nil)
(defvar-local stringbed--selected-id nil)
(defvar-local stringbed--catalog-kind nil)
(defvar-local stringbed--catalog-scope nil)
(defvar-local stringbed--catalog-items nil)
(defvar-local stringbed--catalog-term nil)
(defvar-local stringbed--catalog-generation 0)
(defvar-local stringbed--form-revision nil)
(defvar-local stringbed--form-widgets nil)
(defvar-local stringbed--form-error-marker nil)
(defvar-local stringbed--form-submit nil)
(defvar-local stringbed--form-meta nil)
(defvar stringbed--spinner 0)

(defun stringbed--get (object key &optional default)
  "Read KEY from OBJECT, returning DEFAULT when absent."
  (if (hash-table-p object) (gethash key object default)
    (let ((cell (or (assq key object) (assoc (symbol-name key) object))))
      (if cell (cdr cell) default))))
(defun stringbed--true-p (value) (and value (not (memq value '(:false :null)))))
(defun stringbed--json (value)
  (let ((json-false :false) (json-null :null)) (json-encode value)))
(defun stringbed--parse (text)
  (json-parse-string text :object-type 'alist :array-type 'array :null-object :null :false-object :false))
(defun stringbed--object (&rest pairs)
  (let ((object (make-hash-table :test #'equal)))
    (while pairs (puthash (pop pairs) (pop pairs) object)) object))
(defun stringbed--conn ()
  (or stringbed--connection (user-error "Open a Stringbed workspace first")))
(defun stringbed--alive-p (connection)
  (process-live-p (stringbed--connection-process connection)))
(defun stringbed--attach (connection)
  (setq-local stringbed--connection connection)
  (cl-pushnew (current-buffer) (stringbed--connection-buffers connection))
  (setq-local mode-line-process '(:eval (stringbed--mode-line))))
(defun stringbed--mode-line ()
  (when stringbed--connection
    (let ((pending (hash-table-count (stringbed--connection-pending stringbed--connection))))
      (format " [%s%s]" (if (> pending 0) (concat (aref ["◐ " "◓ " "◑ " "◒ "] (% stringbed--spinner 4))) "")
              (stringbed--connection-status stringbed--connection)))))
(defun stringbed--tick (connection)
  (if (not (stringbed--alive-p connection))
      (when (timerp (stringbed--connection-timer connection))
        (cancel-timer (stringbed--connection-timer connection)))
    (cl-incf stringbed--spinner)
    (dolist (buffer (stringbed--connection-buffers connection))
      (when (buffer-live-p buffer) (with-current-buffer buffer (force-mode-line-update))))))

(defun stringbed--request (connection method params callback &optional mutation on-error)
  "Send METHOD asynchronously.  CALLBACK receives result and full response."
  (unless (stringbed--alive-p connection) (user-error "Stringbed backend is disconnected; reopen the workspace"))
  (when (and mutation (stringbed--connection-mutation connection))
    (user-error "An edit is still being validated; wait for it to finish"))
  (let* ((id (cl-incf (stringbed--connection-counter connection)))
         (revision (stringbed--connection-revision connection))
         (request `((v . 1) (id . ,id) (method . ,method) (params . ,(or params (make-hash-table))))))
    (unless (equal method "open")
      (setq request (append request `((session . ,(stringbed--connection-session connection)) (revision . ,revision)))))
    (puthash id (list :callback callback :on-error on-error :revision revision :mutation mutation
                      :method method :buffer (current-buffer)) (stringbed--connection-pending connection))
    (when mutation (setf (stringbed--connection-mutation connection) id))
    (setf (stringbed--connection-status connection) (concat method "…"))
    (process-send-string (stringbed--connection-process connection) (concat (stringbed--json request) "\n"))
    id))
(defun stringbed--filter (process text)
  (let* ((connection (process-get process 'stringbed-connection))
         (fragment (concat (stringbed--connection-fragment connection) text))
         (start 0))
    (while (string-match "\n" fragment start)
      (let ((line (substring fragment start (match-beginning 0))))
        (setq start (match-end 0))
        (unless (string-empty-p line)
          (condition-case error
              (stringbed--receive connection (stringbed--parse line))
            (error (setf (stringbed--connection-status connection) "Protocol error")
                   (message "Stringbed protocol error: %s" (error-message-string error)))))))
    (setf (stringbed--connection-fragment connection) (substring fragment start))))
(defun stringbed--receive (connection response)
  "Process one data-only RESPONSE; old revisions never repaint a view."
  (unless (equal (stringbed--get response 'v) 1) (error "Unsupported Stringbed protocol"))
  (let* ((id (stringbed--get response 'id))
         (pending (gethash id (stringbed--connection-pending connection)))
         (revision (stringbed--get response 'revision 0))
         (token (stringbed--get response 'session)))
    (when pending
      (if (equal (stringbed--get response 'event) "progress")
          (setf (stringbed--connection-status connection) (stringbed--get response 'message "Working…"))
        (remhash id (stringbed--connection-pending connection))
        (when (equal id (stringbed--connection-mutation connection))
          (setf (stringbed--connection-mutation connection) nil))
        (let ((error (stringbed--get response 'error))
              (open (equal (plist-get pending :method) "open")))
          (cond
           ((and (not open) (not (equal token (stringbed--connection-session connection))))
            (setf (stringbed--connection-status connection) "Discarded old session"))
           (error
            (setf (stringbed--connection-status connection) (stringbed--get error 'message "Failed"))
            (let ((handler (plist-get pending :on-error)) (buffer (plist-get pending :buffer)))
              (if (and handler (buffer-live-p buffer))
                  (with-current-buffer buffer (funcall handler error))
                (message "Stringbed: %s" (stringbed--get error 'message "Request failed")))))
           ((< revision (stringbed--connection-revision connection))
            (setf (stringbed--connection-status connection) "Result is stale; refresh"))
           (t
            (setf (stringbed--connection-session connection) token
                  (stringbed--connection-revision connection) revision
                  (stringbed--connection-status connection) "Ready")
            (let ((callback (plist-get pending :callback)) (buffer (plist-get pending :buffer)))
              (when callback
                (if (buffer-live-p buffer)
                    (with-current-buffer buffer (funcall callback (stringbed--get response 'result) response))
                  (funcall callback (stringbed--get response 'result) response)))))))))))
(defun stringbed--sentinel (process event)
  (unless (process-live-p process)
    (let ((connection (process-get process 'stringbed-connection)))
      (when connection
        (setf (stringbed--connection-status connection) (concat "Disconnected: " (string-trim event))
              (stringbed--connection-mutation connection) nil)
        (clrhash (stringbed--connection-pending connection))
        (stringbed--tick connection)))))

;;;###autoload
(defun stringbed-open (path &optional data-only)
  "Open existing workspace PATH.  With prefix DATA-ONLY, do not load extensions."
  (interactive (list (read-file-name "Stringbed workspace: " nil nil t) current-prefix-arg))
  (setq path (expand-file-name path))
  (unless (file-regular-p path) (user-error "Choose an existing workspace file"))
  (when (and (called-interactively-p 'interactive) stringbed-confirm-trusted-code (not data-only))
    (setq data-only (not (y-or-n-p "Load this workspace's trusted Racket extensions? (n: data-only inspection) "))))
  (let* ((buffer (generate-new-buffer (format "*Stringbed: %s*" (file-name-base path))))
         (connection (stringbed--make-connection :path path :root buffer))
         (process (make-process :name "stringbed" :command stringbed-command :connection-type 'pipe
                                :coding 'utf-8-unix :noquery t :buffer nil
                                :stderr (generate-new-buffer " *Stringbed diagnostics*")
                                :filter #'stringbed--filter :sentinel #'stringbed--sentinel)))
    (setf (stringbed--connection-process connection) process)
    (process-put process 'stringbed-connection connection)
    (setf (stringbed--connection-timer connection) (run-with-timer 0.2 0.2 #'stringbed--tick connection))
    (with-current-buffer buffer
      (stringbed-mode) (stringbed--attach connection)
      (let ((inhibit-read-only t)) (magit-insert-section (workspace) (insert "Opening workspace…\n")))
      (add-hook 'kill-buffer-query-functions #'stringbed--confirm-close nil t)
      (add-hook 'kill-buffer-hook #'stringbed--close nil t)
      (add-hook 'kill-emacs-query-functions #'stringbed--confirm-exit)
      (stringbed--request connection "open" `((path . ,path) (dataOnly . ,(if data-only t :false)))
                          (lambda (view _) (stringbed--accept-view connection view))))
    (pop-to-buffer buffer) buffer))
(defun stringbed-standalone ()
  "Open STRINGBED_WORKSPACE in a minimal terminal or graphical Emacs."
  (interactive)
  (unless (display-graphic-p) (xterm-mouse-mode 1))
  (menu-bar-mode -1)
  (let ((path (or (getenv "STRINGBED_WORKSPACE") (pop command-line-args-left))))
    (unless path (setq path (read-file-name "Existing Stringbed workspace: " nil nil t)))
    (stringbed-open path)))
(defun stringbed--confirm-close ()
  (or (not stringbed--connection)
      (and (not (stringbed--true-p (stringbed--get (stringbed--connection-workspace stringbed--connection) 'dirty)))
           (not (stringbed--connection-mutation stringbed--connection)))
      (y-or-n-p "Discard Stringbed's unsaved draft or pending edit? ")))
(defun stringbed--confirm-exit ()
  (cl-every (lambda (buffer)
              (with-current-buffer buffer
                (or (not (derived-mode-p 'stringbed-mode))
                    (not stringbed--connection)
                    (not (eq buffer (stringbed--connection-root stringbed--connection)))
                    (stringbed--confirm-close))))
            (buffer-list)))
(defun stringbed--close ()
  (when (and stringbed--connection
             (eq (current-buffer) (stringbed--connection-root stringbed--connection)))
    (when (timerp (stringbed--connection-timer stringbed--connection))
      (cancel-timer (stringbed--connection-timer stringbed--connection)))
    (when (stringbed--alive-p stringbed--connection)
      (delete-process (stringbed--connection-process stringbed--connection)))))
(defun stringbed--accept-view (connection view)
  (setf (stringbed--connection-workspace connection) view)
  (let ((buffer (stringbed--connection-root connection)))
    (when (buffer-live-p buffer)
      (with-current-buffer buffer
        (setq stringbed--selected-id (or (stringbed--get view 'selectedId) stringbed--selected-id))
        (stringbed--render)))))
(defun stringbed--mutate (method params &optional done on-error)
  (let ((connection (stringbed--conn)))
    (when (stringbed--true-p (stringbed--get (stringbed--connection-workspace connection) 'readOnly))
      (user-error "This workspace is open for data-only inspection"))
    (stringbed--request connection method params
                        (lambda (view response)
                          (stringbed--accept-view connection view)
                          (when (derived-mode-p 'stringbed-form-mode)
                            (setq stringbed--form-revision (stringbed--connection-revision connection)))
                          (when done (funcall done view response))) t on-error)))

(defvar stringbed-mode-map
  (let ((map (make-sparse-keymap)))
    (set-keymap-parent map magit-section-mode-map)
    (dolist (pair '(("g" . stringbed-refresh) ("a" . stringbed-find-package) ("o" . stringbed-find-option)
                    ("e" . stringbed-edit) ("RET" . stringbed-visit) ("n" . stringbed-note)
                    ("D" . stringbed-documentation) ("w" . stringbed-provenance) ("p" . stringbed-preview)
                    ("d" . stringbed-diff) ("s" . stringbed-save) ("u" . stringbed-undo)
                    ("x" . stringbed-remove) ("l" . stringbed-language) ("f" . stringbed-source)
                    ("C-c C-k" . stringbed-cancel) ("?" . stringbed-dispatch)))
      (define-key map (kbd (car pair)) (cdr pair))) map))
(define-derived-mode stringbed-mode magit-section-mode "Stringbed"
  "Workspace tree.  TAB folds, RET edits; ? lists actions."
  (setq truncate-lines t)
  (setq-local revert-buffer-function (lambda (&rest _) (stringbed-refresh))))
(defun stringbed--button (label action &optional help)
  (insert-text-button label 'follow-link t 'help-echo help 'action (lambda (_) (funcall action))))
(defun stringbed--node-at-point ()
  (or (get-text-property (point) 'stringbed-node)
      (let ((section (magit-current-section)))
        (and section (eq (oref section type) 'node) (oref section value)))
      stringbed--selected-id))
(defun stringbed--node (&optional id)
  (let* ((view (stringbed--connection-workspace (stringbed--conn)))
         (selected (or id (stringbed--node-at-point)))
         (node (cl-find selected (stringbed--get view 'nodes) :key (lambda (n) (stringbed--get n 'id)) :test #'equal)))
    (or node (user-error "Move to a package, option or module first"))))
(defun stringbed--render ()
  (let* ((view (stringbed--connection-workspace (stringbed--conn)))
         (selected (stringbed--node-at-point))
         (inhibit-read-only t))
    (erase-buffer)
    (magit-insert-section (workspace)
      (insert (propertize (format "Stringbed · %s" (stringbed--get view 'name)) 'face 'stringbed-title)
              (if (stringbed--true-p (stringbed--get view 'dirty)) "  • unsaved" "  saved") "\n")
      (insert (format "%s  ·  %s  ·  revision %s\n" (stringbed--get view 'target) (stringbed--get view 'system)
                      (stringbed--connection-revision stringbed--connection)))
      (insert (propertize (concat (stringbed--get view 'path "") "\n\n") 'face 'stringbed-muted))
      (when (stringbed--true-p (stringbed--get view 'readOnly))
        (insert (propertize "Data-only inspection · extension code has not been loaded\n\n" 'face 'warning)))
      (dolist (action '(("[a Find package]" . stringbed-find-package) ("[o Find option]" . stringbed-find-option)
                        ("[l Language]" . stringbed-language) ("[? Actions]" . stringbed-dispatch)))
        (stringbed--button (car action) (cdr action)) (insert "  "))
      (insert "\n\n")
      (dolist (scope (append (stringbed--get view 'scopes) nil))
        (magit-insert-section (scope scope)
          (magit-insert-heading (propertize (format "%s\n" scope) 'face 'bold))
          (let ((nodes (cl-remove-if-not (lambda (n) (equal scope (stringbed--get n 'scope))) (append (stringbed--get view 'nodes) nil))))
            (if (null nodes) (insert (propertize "  No selections yet.  Find a package or option above.\n" 'face 'stringbed-muted))
              (dolist (node nodes)
                (let ((id (stringbed--get node 'id)))
                  (magit-insert-section (node id)
                    (let ((start (point)))
                      (magit-insert-heading
                       (format "  %-9s %s%s\n" (stringbed--get node 'kind) (stringbed--get node 'displayName id)
                               (if (eq (stringbed--get node 'valid) :false) "  [needs attention]" "")))
                      (insert (format "    %s\n" (stringbed--params-summary (stringbed--get node 'params))))
                      (unless (string-empty-p (stringbed--get node 'note ""))
                        (insert (propertize (concat "    " (replace-regexp-in-string "\n" " · " (stringbed--get node 'note)) "\n") 'face 'stringbed-muted)))
                      (add-text-properties start (point) `(stringbed-node ,id))))))))
          (insert "\n")))
      (dolist (diagnostic (append (stringbed--get view 'diagnostics) nil))
        (insert (propertize (format "! %s / %s: %s\n" (stringbed--get diagnostic 'node "Workspace")
                                    (stringbed--get diagnostic 'field "") (stringbed--get diagnostic 'message)) 'face 'error)))
      (insert "\n")
      (dolist (action '(("[d Review changes]" . stringbed-diff) ("[s Save]" . stringbed-save) ("[u Undo]" . stringbed-undo)
                        ("[Export]" . stringbed-export) ("[Evaluate]" . stringbed-evaluate) ("[Build]" . stringbed-build)))
        (stringbed--button (car action) (cdr action)) (insert "  "))
      (insert "\n\n" (propertize "Nix validation is separate from structural validity. Evaluate to check the complete configuration.\n" 'face 'stringbed-muted))
      (insert (propertize "TAB fold · RET edit · w provenance · p selected Nix · f implementation · C-c C-k cancel\n" 'face 'stringbed-muted)))
    (goto-char (point-min))
    (when selected
      (let ((position (point-min)))
        (while (and (< position (point-max)) (not (equal selected (get-text-property position 'stringbed-node))))
          (setq position (next-single-property-change position 'stringbed-node nil (point-max))))
        (when (< position (point-max)) (goto-char position))))
    (set-buffer-modified-p nil)))
(defun stringbed--params-summary (params)
  (mapconcat (lambda (pair) (format "%s = %s" (car pair) (stringbed--display-value (cdr pair)))) params "   "))
(defun stringbed--display-value (value)
  (cond ((eq value t) "true") ((eq value :false) "false") ((eq value :null) "null")
        ((stringp value) value) (t (stringbed--json value))))
(defun stringbed-refresh ()
  (interactive)
  (let ((connection (stringbed--conn)))
    (stringbed--request connection "workspace" nil (lambda (view _) (stringbed--accept-view connection view)))))
(defun stringbed-save () (interactive) (stringbed--mutate "save" nil))
(defun stringbed-undo () (interactive) (stringbed--mutate "undo" nil))
(defun stringbed-remove ()
  (interactive)
  (let ((node (stringbed--node)))
    (when (y-or-n-p (format "Remove %s from desired configuration? " (stringbed--get node 'displayName)))
      (stringbed--mutate "remove" `((node . ,(stringbed--get node 'id)))))))
(defun stringbed-visit () (interactive) (if (button-at (point)) (push-button) (stringbed-edit)))
(defun stringbed-cancel ()
  (interactive)
  (let* ((connection (stringbed--conn)) (pending (stringbed--connection-pending connection)) choices)
    (maphash (lambda (id entry) (when (member (plist-get entry :method) '("context" "package-search" "option-search" "option-detail" "evaluate" "build" "provenance"))
                                (push (cons (format "%s #%s" (plist-get entry :method) id) id) choices))) pending)
    (unless choices (user-error "No cancellable query is running; edits finish atomically"))
    (let ((id (if (= (length choices) 1) (cdar choices)
                (cdr (assoc (completing-read "Cancel request: " choices nil t) choices)))))
      (stringbed--request connection "cancel" `((request . ,id))
                          (lambda (result _) (message "Cancellation requested: %s" (stringbed--get result 'cancelled)))))))

(defun stringbed--scope (&optional connection)
  (let* ((connection (or connection (stringbed--conn)))
         (scopes (stringbed--get (stringbed--connection-workspace connection) 'scopes)))
    (if (= (length scopes) 1) (elt scopes 0) (completing-read "Configuration scope: " (append scopes nil) nil t))))
(defun stringbed-prepare-inputs ()
  "Create the initial input lock, or reuse the current lock unchanged."
  (interactive)
  (let ((connection (stringbed--conn)))
    (stringbed--request connection "context" '((initialize . t))
                        (lambda (result _) (stringbed--show-data connection "Pinned inputs" result)))))
(defun stringbed-use-lock (path)
  "Use an existing lock file PATH for this workspace's query context."
  (interactive (list (read-file-name "Existing flake.lock: " nil nil t)))
  (let ((connection (stringbed--conn)))
    (stringbed--request connection "context" `((lockFile . ,(expand-file-name path)))
                        (lambda (result _) (stringbed--show-data connection "Pinned inputs" result)))))
(defun stringbed-find-package (&optional term)
  "Search pinned packages by name or description."
  (interactive)
  (stringbed--catalog-search "package" (or term (read-string "Package name or description: ")) (stringbed--scope)))
(defun stringbed-find-option (&optional term)
  "Search actual module options for the selected scope."
  (interactive)
  (stringbed--catalog-search "option" (or term (read-string "Option name or description: ")) (stringbed--scope)))
(defvar stringbed-catalog-mode-map
  (let ((map (make-sparse-keymap)))
    (set-keymap-parent map tabulated-list-mode-map)
    (define-key map (kbd "RET") #'stringbed-catalog-inspect)
    (define-key map (kbd "a") #'stringbed-catalog-add)
    (define-key map (kbd "/") #'stringbed-catalog-search-again)
    (define-key map (kbd "g") #'stringbed-catalog-refresh)
    (define-key map (kbd "C-c C-k") #'stringbed-cancel)
    (define-key map [mouse-2] #'stringbed-catalog-mouse-inspect) map))
(define-derived-mode stringbed-catalog-mode tabulated-list-mode "Stringbed Catalogue"
  "RET inspects the selection; a adds it; / changes the query."
  (setq truncate-lines t tabulated-list-padding 2)
  (setq-local revert-buffer-function (lambda (&rest _) (stringbed-catalog-refresh))))
(defun stringbed--catalog-search (kind term scope &optional buffer exact)
  (let* ((connection (stringbed--conn))
         (buffer (or buffer (generate-new-buffer (format "*Stringbed %s catalogue*" kind))))
         (generation (1+ (buffer-local-value 'stringbed--catalog-generation buffer))))
    (with-current-buffer buffer
      (stringbed-catalog-mode) (stringbed--attach connection)
      (setq stringbed--catalog-generation generation)
      (setq stringbed--catalog-kind kind stringbed--catalog-scope scope stringbed--catalog-term term)
      (setq tabulated-list-format (if (equal kind "package")
                                     [("Package" 32 t) ("Version" 14 t) ("Description" 80 t)]
                                   [("Option" 44 t) ("Type" 23 t) ("Description" 70 t)]))
      (setq header-line-format (format "%s · %s · %s   RET inspect · a add · / search · C-c C-k cancel" kind scope term))
      (tabulated-list-init-header)
      (stringbed--request
       connection (concat kind "-search") `((term . ,term) (scope . ,scope) (mode . ,(if exact "exact" "search")))
       (lambda (result _)
         (when (and (buffer-live-p buffer)
                    (= generation (buffer-local-value 'stringbed--catalog-generation buffer)))
           (with-current-buffer buffer
             (setq stringbed--catalog-items (append (stringbed--get result 'items) nil))
             (setq tabulated-list-entries
                   (mapcar (lambda (item)
                             (let ((name (stringbed--get item (if (equal kind "package") 'attribute 'path))))
                               (list name (vector name
                                                  (stringbed--get item (if (equal kind "package") 'version 'type) "")
                                                  (replace-regexp-in-string "[\n\r]+" " " (stringbed--get item 'description ""))))))
                           stringbed--catalog-items))
             (tabulated-list-print t)
             (setq mode-name (format "%s (%d%s)" (capitalize kind) (length stringbed--catalog-items)
                                     (if (stringbed--true-p (stringbed--get result 'cached)) ", cached" "")))
             (unless stringbed--catalog-items (message "No matching %s; try another name or description" kind)))))
       nil (lambda (error)
             (when (and (buffer-live-p buffer) (= generation (buffer-local-value 'stringbed--catalog-generation buffer)))
               (stringbed--catalog-error connection error kind term scope buffer)))))
    (pop-to-buffer buffer)))
(defun stringbed--catalog-error (_connection error kind term scope buffer)
  (let ((message (stringbed--get error 'message "Query failed")))
    (with-current-buffer buffer
      (let ((inhibit-read-only t))
        (erase-buffer) (insert (propertize (concat message "\n\n") 'face 'error))
        (stringbed--button "Prepare initial input lock" (lambda () (with-current-buffer buffer (stringbed-prepare-inputs))))
        (insert "  ")
        (stringbed--button "Use an existing flake.lock" (lambda () (with-current-buffer buffer (call-interactively #'stringbed-use-lock))))
        (insert "\n\n")
        (stringbed--button "Retry query" (lambda () (with-current-buffer buffer (stringbed--catalog-search kind term scope buffer))))
        (when (equal kind "package")
          (insert "  ")
          (stringbed--button "Try exact attribute lookup" (lambda () (with-current-buffer buffer (stringbed--catalog-search kind term scope buffer t)))))
        (insert "\n\nThe input lock fixes the upstream revisions used for discovery and validation.\n"
                "Broad package searches can take time; exact attribute lookup uses fewer resources.\n")))))
(defun stringbed-catalog-search-again ()
  (interactive)
  (stringbed--catalog-search stringbed--catalog-kind (read-string "Search: " stringbed--catalog-term)
                            stringbed--catalog-scope (current-buffer)))
(defun stringbed-catalog-refresh ()
  (interactive) (stringbed--catalog-search stringbed--catalog-kind stringbed--catalog-term stringbed--catalog-scope (current-buffer)))
(defun stringbed--catalog-item ()
  (let ((id (tabulated-list-get-id)))
    (or (cl-find id stringbed--catalog-items :key (lambda (x) (stringbed--get x (if (equal stringbed--catalog-kind "package") 'attribute 'path))) :test #'equal)
        (user-error "Move to a catalogue result first"))))
(defun stringbed-catalog-mouse-inspect (event)
  (interactive "e") (mouse-set-point event) (stringbed-catalog-inspect))
(defun stringbed-catalog-inspect ()
  (interactive)
  (let ((item (stringbed--catalog-item)) (scope stringbed--catalog-scope) (connection (stringbed--conn)))
    (if (equal stringbed--catalog-kind "package")
        (stringbed--request connection "package-search"
                            `((term . ,(stringbed--get item 'attribute)) (mode . "exact") (scope . ,scope))
                            (lambda (result _)
                              (let ((items (stringbed--get result 'items)))
                                (unless (> (length items) 0) (user-error "This package is unavailable in the current input lock"))
                                (stringbed--package-detail connection (elt items 0) scope))))
      (stringbed--request connection "option-detail" `((path . ,(stringbed--get item 'path)) (scope . ,scope))
                          (lambda (detail _) (stringbed--option-form connection detail scope))))))
(defun stringbed-catalog-add ()
  (interactive)
  (let ((item (stringbed--catalog-item)))
    (if (equal stringbed--catalog-kind "package")
        (stringbed--mutate "add-package" `((attribute . ,(stringbed--get item 'attribute)) (scope . ,stringbed--catalog-scope))
                          (lambda (_ _) (pop-to-buffer (stringbed--connection-root (stringbed--conn)))))
      (stringbed-catalog-inspect))))
(defun stringbed--detail-buffer (connection name)
  (let ((buffer (generate-new-buffer (format "*Stringbed: %s*" name))))
    (with-current-buffer buffer (special-mode) (stringbed--attach connection)) buffer))
(defun stringbed--package-detail (connection item scope)
  (let ((buffer (stringbed--detail-buffer connection (stringbed--get item 'attribute))))
    (with-current-buffer buffer
      (let ((inhibit-read-only t))
        (insert (propertize (stringbed--get item 'attribute) 'face 'stringbed-title)
                "\n" (stringbed--get item 'description "") "\n\n"
                "Version: " (stringbed--get item 'version "") "\nScope: " scope "\n\n")
        (stringbed--button "Add this package" (lambda () (stringbed--mutate "add-package" `((attribute . ,(stringbed--get item 'attribute)) (scope . ,scope)))))
        (insert "\n\nUpstream documentation\n")
        (let ((links (stringbed--get item 'homepage)))
          (dolist (link (if (stringp links) (list links) (append links nil))) (stringbed--url-button link) (insert "\n")))
        (let ((position (stringbed--get item 'position)))
          (when (and (stringp position) (not (string-empty-p position)))
            (insert "\n") (stringbed--button "Open Nix implementation" (lambda () (stringbed--visit-source position)))))
        (insert "\n\nApplication flags and module options are separate. Find options for this scope with o.\n")))
    (pop-to-buffer buffer)))

(defvar stringbed-field-keymap
  (let ((map (copy-keymap widget-field-keymap)))
    (define-key map (kbd "C-c C-c") #'stringbed-form-submit)
    (define-key map (kbd "C-c C-k") #'stringbed-cancel)
    (define-key map (kbd "C-c C-q") #'quit-window) map))
(defvar stringbed-form-mode-map
  (let ((map (copy-keymap widget-keymap)))
    (define-key map (kbd "C-c C-c") #'stringbed-form-submit)
    (define-key map (kbd "C-c C-k") #'stringbed-cancel)
    (define-key map (kbd "C-c C-q") #'quit-window) map))
(define-derived-mode stringbed-form-mode fundamental-mode "Stringbed Form"
  "Typed values with atomic backend validation.  C-c C-c submits."
  (use-local-map stringbed-form-mode-map)
  (setq-local truncate-lines nil))
(defun stringbed--field (name control value description)
  "Insert a widget for CONTROL, retaining typed JSON values."
  (insert (propertize (concat name "\n") 'face 'bold))
  (when (and description (not (string-empty-p description)))
    (insert (propertize (concat description "\n") 'face 'stringbed-muted)))
  (when (and (equal (stringbed--get control 'kind) "string")
             (not (stringp value)) (not (eq value :stringbed-unset)))
    (insert (propertize "The existing value is not a string. Correct its JSON value (put strings in quotes).\n" 'face 'error))
    (setq control '((kind . "advanced"))))
  (let* ((kind (stringbed--get control 'kind "advanced"))
         (widget
          (cond
           ((equal kind "boolean")
            (if (memq value '(t :false))
                (widget-create 'checkbox :value (eq value t))
              (insert (propertize (if (eq value :stringbed-unset) "Choose true or false; no default is declared.\n"
                                    (format "Existing value %s is not a Boolean. Choose true or false.\n" (stringbed--display-value value))) 'face 'error))
              (widget-create 'menu-choice :tag "Boolean" :value :stringbed-unset
                             '(const :tag "Choose true or false" :stringbed-unset)
                             '(const :tag "true" t) '(const :tag "false" :false))))
           ((equal kind "enum")
            (apply #'widget-create 'menu-choice :tag "Choose value" :value value
                   (mapcar (lambda (choice) `(const :tag ,(stringbed--display-value choice) ,choice)) (stringbed--get control 'choices))))
           ((equal kind "nullable")
            (widget-create 'editable-field :keymap stringbed-field-keymap :size 60 :value (if (eq value :stringbed-unset) "" (stringbed--json value))))
           ((member kind '("integer" "number"))
            (widget-create 'editable-field :keymap stringbed-field-keymap :size 24 :value (if (numberp value) (number-to-string value) "")))
           ((equal kind "string")
            (widget-create 'editable-field :keymap stringbed-field-keymap :size 60 :value (if (stringp value) value "")))
           (t
            (insert (propertize "JSON value (strings in quotes; lists [ ]; objects { }; null allowed by schema)\n" 'face 'stringbed-muted))
            (widget-create 'editable-field :keymap stringbed-field-keymap :size 70 :value (if (eq value :stringbed-unset) "" (stringbed--json value)))))))
    (widget-put widget :stringbed-name name)
    (widget-put widget :stringbed-control control)
    (push (cons name widget) stringbed--form-widgets)
    (insert "\n\n") widget))
(defun stringbed--field-value (widget)
  (let* ((value (widget-value widget))
         (kind (stringbed--get (widget-get widget :stringbed-control) 'kind "advanced")))
    (cond ((equal kind "boolean")
           (when (eq value :stringbed-unset) (user-error "Choose true or false; the original value is invalid"))
           (if (eq value t) t :false))
          ((member kind '("enum" "string")) value)
          ((member kind '("integer" "number"))
           (unless (string-match-p (if (equal kind "integer") "\\`[-+]?[0-9]+\\'" "\\`[-+]?[0-9]+\\(?:\\.[0-9]+\\)?\\(?:[eE][-+]?[0-9]+\\)?\\'") value)
             (user-error "%s: enter a %s" (widget-get widget :stringbed-name) kind))
           (string-to-number value))
          (t (condition-case nil (stringbed--parse value)
               (error (user-error "%s: enter valid JSON" (widget-get widget :stringbed-name))))))))
(defun stringbed--finish-form (submit)
  (setq stringbed--form-submit submit
        stringbed--form-revision (stringbed--connection-revision (stringbed--conn)))
  (setq stringbed--form-error-marker (copy-marker (point)))
  (insert "\n")
  (widget-create 'push-button :notify (lambda (&rest _) (stringbed-form-submit)) "Validate and apply")
  (insert "  ") (widget-create 'push-button :notify (lambda (&rest _) (quit-window)) "Close")
  (insert "\n\nC-c C-c validates and updates the draft. Save the workspace separately.\n")
  (widget-setup)
  (goto-char (point-min)) (set-buffer-modified-p nil))
(defun stringbed--form-error (error)
  (let ((message (stringbed--get error 'message "Validation failed")) (field (stringbed--get error 'field)))
    (let ((inhibit-read-only t))
      (save-excursion
        (goto-char stringbed--form-error-marker)
        (insert (propertize (format "%s%s\n" (if field (concat field ": ") "") message) 'face 'error))))
    (when-let ((widget (cdr (assoc field stringbed--form-widgets))))
      (goto-char (or (widget-field-start widget) (widget-get widget :from) (point-min))))
    (message "%s" message)))
(defun stringbed-form-submit ()
  (interactive)
  (unless stringbed--form-submit (user-error "No form to submit"))
  (condition-case error
      (progn
        (unless (= stringbed--form-revision (stringbed--connection-revision (stringbed--conn)))
          (user-error "This form is stale; reopen it from the refreshed workspace before applying"))
      (let ((values (make-hash-table :test #'equal)))
        (dolist (entry stringbed--form-widgets) (puthash (car entry) (stringbed--field-value (cdr entry)) values))
        (funcall stringbed--form-submit values)))
    (error (stringbed--form-error `((message . ,(error-message-string error)))))))
(defun stringbed--option-form (connection detail scope &optional node)
  (let* ((path (stringbed--get detail 'path))
         (buffer (generate-new-buffer (format "*Stringbed option: %s*" path))))
    (with-current-buffer buffer
      (stringbed-form-mode) (stringbed--attach connection)
      (insert (propertize (concat path "\n") 'face 'stringbed-title) "Scope: " scope "\n"
              (stringbed--get detail 'description "") "\n\n")
      (dolist (source (append (stringbed--get detail 'declarations) nil))
        (stringbed--button (concat "Nix declaration: " source) (lambda () (stringbed--visit-source source))) (insert "\n"))
      (insert "\n")
      (stringbed--field "value" (stringbed--get detail 'control)
                        (if node (stringbed--get (stringbed--get node 'params) 'value)
                          (let ((default (stringbed--get detail 'default :stringbed-unset)))
                            (if (and (listp default) (assq 'unavailable default)) :stringbed-unset default)))
                        (stringbed--get detail 'type ""))
      (stringbed--finish-form
       (lambda (values)
         (if node
             (stringbed--mutate "edit" `((node . ,(stringbed--get node 'id)) (values . ,values))
                               (lambda (_ _) (message "Option validated and draft updated")) #'stringbed--form-error)
           (stringbed--mutate "add-option" `((path . ,path) (value . ,(gethash "value" values)) (scope . ,scope))
                             (lambda (_ _)
                               (when (buffer-live-p buffer) (kill-buffer buffer))
                               (pop-to-buffer (stringbed--connection-root connection))
                               (message "Option validated and added to draft")) #'stringbed--form-error)))))
    (pop-to-buffer buffer)))
(defun stringbed--forms (connection callback)
  (if (stringbed--connection-forms connection) (funcall callback (stringbed--connection-forms connection))
    (stringbed--request connection "forms" nil (lambda (forms _)
                                                (setf (stringbed--connection-forms connection) forms)
                                                (funcall callback forms)))))
(defun stringbed-edit ()
  (interactive)
  (let* ((node (stringbed--node)) (connection (stringbed--conn)))
    (if (equal (stringbed--get node 'kind) "option")
        (stringbed--request connection "option-detail" `((path . ,(stringbed--get (stringbed--get node 'params) 'path)) (scope . ,(stringbed--get node 'scope)))
                            (lambda (detail _) (stringbed--option-form connection detail (stringbed--get node 'scope) node)))
      (stringbed--forms connection
                        (lambda (forms)
                          (let ((form (cl-find (stringbed--get node 'kind) forms :key (lambda (f) (stringbed--get f 'kind)) :test #'equal)))
                            (unless form (user-error "This form is unavailable; use data-only inspection"))
                            (stringbed--generic-form connection form (stringbed--get node 'scope) node)))))))
(defun stringbed--generic-form (connection descriptor scope &optional node)
  (let ((buffer (generate-new-buffer (format "*Stringbed %s form*" (stringbed--get descriptor 'kind)))))
    (with-current-buffer buffer
      (stringbed-form-mode) (stringbed--attach connection)
      (insert (propertize (concat (stringbed--get descriptor 'description) "\n\n") 'face 'stringbed-title))
      (stringbed--field "displayName" '((kind . "string")) (if node (stringbed--get node 'displayName) "") "Optional display label; internal identity is preserved separately.")
      (dolist (field (append (stringbed--get descriptor 'fields) nil))
        (let ((name (stringbed--get field 'name)) (type (stringbed--get field 'type)))
          (stringbed--field name `((kind . ,(cond ((member type '("string" "attribute")) "string")
                                                  ((member type '("integer" "port")) "integer")
                                                  ((equal type "boolean") "boolean") (t "advanced"))))
                            (if node (stringbed--get (stringbed--get node 'params) (intern name)) (stringbed--get field 'default))
                            (stringbed--get field 'description ""))))
      (stringbed--finish-form
       (lambda (values)
         (let ((label (gethash "displayName" values)))
           (remhash "displayName" values)
           (stringbed--mutate (if node "edit" "add")
                             (append (if node `((node . ,(stringbed--get node 'id))) `((kind . ,(stringbed--get descriptor 'kind))))
                                     `((scope . ,scope) (displayName . ,label) (values . ,values)))
                             (lambda (_ _)
                               (unless node
                                 (when (buffer-live-p buffer) (kill-buffer buffer))
                                 (pop-to-buffer (stringbed--connection-root connection)))
                               (message "Validated and updated draft")) #'stringbed--form-error)))))
    (pop-to-buffer buffer)))

(defun stringbed-note ()
  (interactive)
  (let ((node (stringbed--node)) (connection (stringbed--conn)))
    (stringbed--annotation-form connection node "Personal note" "text" (stringbed--get node 'note "") "note")))
(defun stringbed-documentation ()
  (interactive)
  (let ((node (stringbed--node)) (connection (stringbed--conn)))
    (stringbed--annotation-form connection node "Documentation links (one URL per line)" "links"
                               (mapconcat #'identity (stringbed--get node 'docs) "\n") "docs")))
(defun stringbed--annotation-form (connection node title field value method)
  (let ((buffer (generate-new-buffer (format "*Stringbed: %s*" title))))
    (with-current-buffer buffer
      (stringbed-form-mode) (stringbed--attach connection)
      (insert (propertize (concat title "\n") 'face 'stringbed-title)
              (stringbed--get node 'displayName) "\n\n")
      (stringbed--field field '((kind . "string")) value nil)
      (stringbed--finish-form
       (lambda (values)
         (stringbed--mutate method
                           `((node . ,(stringbed--get node 'id))
                             (,(intern field) . ,(if (equal field "links")
                                                   (vconcat (split-string (gethash field values) "[\n\r]+" t "[ \t]+"))
                                                 (gethash field values))))
                           (lambda (_ _) (message "Annotation updated in draft")) #'stringbed--form-error))))
    (pop-to-buffer buffer)))
(defun stringbed--url-button (url)
  (when (stringp url)
    (stringbed--button url (lambda ()
                            (if (string-match-p "\\`https?://" url) (browse-url url)
                              (user-error "Documentation must use an http or https URL"))))))
(defun stringbed--visit-source (location)
  (unless (stringp location) (user-error "No source location is available"))
  (if (string-match-p "\\`https?://" location) (browse-url location)
    (let ((path location) (line 1))
      (when (string-match "\\`\\(.*\\):\\([0-9]+\\)\\(?::[0-9]+\\)?\\'" location)
        (setq path (match-string 1 location) line (string-to-number (match-string 2 location))))
      (unless (file-exists-p path) (user-error "Source is unavailable locally: %s" path))
      (find-file-read-only-other-window path)
      (goto-char (point-min)) (forward-line (1- line)))))
(defun stringbed-source ()
  (interactive)
  (let ((node (stringbed--node)) (connection (stringbed--conn)))
    (stringbed--forms connection
                      (lambda (forms)
                        (let* ((form (cl-find (stringbed--get node 'kind) forms :key (lambda (f) (stringbed--get f 'kind)) :test #'equal))
                               (source (stringbed--get form 'source)))
                          (stringbed--visit-source (stringbed--get source 'path)))))))
(defun stringbed-language ()
  "Browse loaded form contracts, identities and Racket implementations."
  (interactive)
  (let ((connection (stringbed--conn)))
    (stringbed--forms
     connection
     (lambda (forms)
       (let ((buffer (stringbed--detail-buffer connection "Language and modules")))
         (with-current-buffer buffer
           (let ((inhibit-read-only t))
             (insert (propertize "Loaded language and module forms\n\n" 'face 'stringbed-title))
             (dolist (form (append forms nil))
               (insert (propertize (stringbed--get form 'kind) 'face 'bold) "\n"
                       (stringbed--get form 'description "") "\n")
               (dolist (field (append (stringbed--get form 'fields) nil))
                 (insert (format "  %-18s %-12s %s\n" (stringbed--get field 'name) (stringbed--get field 'type)
                                 (stringbed--get field 'description ""))))
               (let* ((source (stringbed--get form 'source)) (path (stringbed--get source 'path)))
                 (when (and path (not (eq path :null)))
                   (stringbed--button "Inspect Racket implementation" (lambda () (stringbed--visit-source path)))
                   (insert "\n" (propertize (format "Revision: %s\n" (stringbed--get source 'sha256 "unknown")) 'face 'stringbed-muted))))
               (unless (member (stringbed--get form 'kind) '("package" "option"))
                 (stringbed--button "Configure a new instance" (lambda () (stringbed--generic-form connection form (stringbed--scope connection)))))
               (insert "\n\n"))
             (insert "Pinned implementations are inspectable snapshots. Create a working derivative and repin with the CLI to change them.\n"
                     "Arbitrary Racket remains editable as source; no visual inverse is assumed.\n")))
         (pop-to-buffer buffer))))))
(defun stringbed--insert-value (value &optional indent)
  "Render structured data as readable labels rather than Lisp expressions."
  (let ((prefix (make-string (or indent 0) ?\s)))
    (cond
     ((and (listp value) (consp (car value)) (symbolp (caar value)))
      (dolist (pair value)
        (insert prefix (propertize (format "%s" (car pair)) 'face 'bold) ": ")
        (if (or (consp (cdr pair)) (vectorp (cdr pair)))
            (progn (insert "\n") (stringbed--insert-value (cdr pair) (+ 2 (or indent 0))))
          (insert (stringbed--display-value (cdr pair)) "\n"))))
     ((or (listp value) (vectorp value))
      (mapc (lambda (item) (insert prefix "• ")
              (if (consp item) (progn (insert "\n") (stringbed--insert-value item (+ 2 (or indent 0))))
                (insert (stringbed--display-value item) "\n"))) value))
     (t (insert prefix (stringbed--display-value value) "\n")))))
(defun stringbed--show-data (connection title data)
  (let ((buffer (stringbed--detail-buffer connection title)))
    (with-current-buffer buffer
      (let ((inhibit-read-only t))
        (insert (propertize (concat title "\n\n") 'face 'stringbed-title))
        (stringbed--insert-value data)))
    (pop-to-buffer buffer)))
(defun stringbed-provenance (&optional evaluated)
  "Explain selected entry.  With prefix EVALUATED, also query Nix."
  (interactive "P")
  (let* ((node (stringbed--node)) (connection (stringbed--conn)) (id (stringbed--get node 'id)))
    (stringbed--request
     connection "provenance" `((node . ,id) (evaluated . ,(if evaluated t :false)))
     (lambda (result _)
       (let ((buffer (generate-new-buffer (format "*Stringbed why: %s*" (stringbed--get node 'displayName)))))
         (with-current-buffer buffer
           (stringbed-mode) (stringbed--attach connection) (setq stringbed--selected-id id)
           (let ((inhibit-read-only t))
             (magit-insert-section (provenance)
               (insert (propertize (format "Why %s · draft revision %s\n\n" (stringbed--get node 'displayName) (stringbed--connection-revision connection)) 'face 'stringbed-title))
               (dolist (section '((selection . "Selection and scope") (relationship . "Composition relationship")
                                  (authored . "Authored entry and personal annotations") (implementation . "Form implementation and revision")
                                  (definitions . "Generated Nix definitions") (evaluation . "Evaluation and freshness")))
                 (magit-insert-section (detail (car section))
                   (magit-insert-heading (concat (cdr section) "\n"))
                   (stringbed--insert-value (stringbed--get result (car section))) (insert "\n")))
               (magit-insert-section (raw nil t)
                 (magit-insert-heading "Advanced raw data\n")
                 (insert (stringbed--json (stringbed--get result 'raw)) "\n\n"))
               (stringbed--button "Evaluate provenance with Nix" (lambda () (stringbed-provenance t)))
               (insert "  ") (stringbed--button "Open Racket implementation" #'stringbed-source)
               (insert "  ") (stringbed--button "Selected Nix" #'stringbed-preview)
               (insert "\n"))))
         (pop-to-buffer buffer))))))
(defun stringbed-preview (&optional whole)
  "Show selected entry's Nix.  With prefix WHOLE show the scope's module."
  (interactive "P")
  (let ((connection (stringbed--conn)))
    (stringbed--request connection "nix" (if whole `((scope . ,(stringbed--scope))) `((node . ,(stringbed--get (stringbed--node) 'id))))
                        (lambda (result _)
                          (let ((buffer (stringbed--detail-buffer connection "Generated Nix")))
                            (with-current-buffer buffer
                              (let ((inhibit-read-only t)) (insert (stringbed--get result 'text)))
                              (when (fboundp 'nix-mode) (nix-mode) (read-only-mode 1) (stringbed--attach connection)))
                            (pop-to-buffer buffer))))))
(defun stringbed-diff ()
  (interactive)
  (let ((connection (stringbed--conn)))
    (stringbed--request connection "diff" nil
                        (lambda (result _)
                          (let ((buffer (stringbed--detail-buffer connection "Changes")))
                            (with-current-buffer buffer
                              (let ((inhibit-read-only t))
                                (insert (propertize "Draft changes\n\n" 'face 'stringbed-title))
                                (dolist (change (append (stringbed--get result 'changes) nil))
                                  (insert (propertize (format "%-10s %s\n" (stringbed--get change 'status) (stringbed--get change 'label)) 'face 'bold))
                                  (let ((before (stringbed--get change 'before)) (after (stringbed--get change 'after)))
                                    (unless (eq before :null) (insert "  Before\n") (stringbed--insert-value before 4))
                                    (unless (eq after :null) (insert "  After\n") (stringbed--insert-value after 4)))
                                (insert "\n"))
                                (insert "\n" (stringbed--get result 'text ""))))
                            (pop-to-buffer buffer))))))
(defun stringbed-export (directory)
  (interactive (list (read-directory-name "Export to a new directory: ")))
  (let ((connection (stringbed--conn)))
    (stringbed--request connection "export" `((directory . ,(expand-file-name directory)))
                        (lambda (result _) (stringbed--show-data connection "Standalone Nix export" result)))))
(defun stringbed-evaluate ()
  (interactive)
  (let ((connection (stringbed--conn)))
    (stringbed--request connection "evaluate" nil (lambda (result _) (stringbed--show-data connection "Nix evaluation" result)))))
(defun stringbed-build ()
  (interactive)
  (let ((connection (stringbed--conn)))
    (stringbed--request connection "build" nil (lambda (result _) (stringbed--show-data connection "Built closure (not activated)" result)))))
(defun stringbed-reopen ()
  (interactive)
  (let* ((connection (stringbed--conn)) (view (stringbed--connection-workspace connection)))
    (when (or (not (stringbed--true-p (stringbed--get view 'dirty)))
              (y-or-n-p "Discard this unsaved draft and reopen from disk? "))
      (let ((path (stringbed--connection-path connection)))
        (with-current-buffer (stringbed--connection-root connection)
          (let ((kill-buffer-query-functions nil)) (kill-buffer)))
        (stringbed-open path)))))
(defun stringbed-git-status ()
  (interactive)
  (unless (fboundp 'magit-status) (user-error "Install Magit for Git history and branches"))
  (magit-status (file-name-directory (stringbed--connection-path (stringbed--conn)))))

(defun stringbed-dispatch ()
  "Show discoverable actions; use Transient when it is installed."
  (interactive)
  (if (fboundp 'stringbed--transient) (stringbed--transient)
    (let* ((actions '(("Find package" . stringbed-find-package) ("Find option" . stringbed-find-option)
                      ("Edit selection" . stringbed-edit) ("Personal note" . stringbed-note) ("Documentation links" . stringbed-documentation)
                      ("Provenance" . stringbed-provenance) ("Selected Nix" . stringbed-preview) ("Language browser" . stringbed-language)
                      ("Review changes" . stringbed-diff) ("Save" . stringbed-save) ("Undo" . stringbed-undo) ("Reopen" . stringbed-reopen)
                      ("Prepare initial input lock" . stringbed-prepare-inputs) ("Use existing lock" . stringbed-use-lock)
                      ("Export" . stringbed-export) ("Evaluate" . stringbed-evaluate) ("Build" . stringbed-build) ("Cancel request" . stringbed-cancel)))
           (selection (completing-read "Stringbed action: " actions nil t)))
      (call-interactively (cdr (assoc selection actions))))))
(when (require 'transient nil t)
  (eval
   '(transient-define-prefix stringbed--transient ()
      "Inspect, author and validate your workspace."
