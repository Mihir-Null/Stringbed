;;; builder-ui-test.el --- Visual builder behavior -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'stringbed-builder)

(defun stringbed-builder-test--spec ()
  (copy-tree '((schema . 1) (kind . "test-module") (description . "A test module")
               (parameters . []) (assignments . []) (compositions . []) (note . "") (docs . []) (sources . [])) t))
(defun stringbed-builder-test--forms ()
  [((kind . "package") (description . "Install a selected package") (available . t)
    (source . ((kind . "builtin")))
    (fields . [((name . "attribute") (type . "attribute") (default . :false) (description . "nixpkgs attribute"))]))])
(defmacro stringbed-builder-test--with-buffer (&rest body)
  `(let* ((connection (stringbed--make-connection :workspace '((scopes . ["home"]) (readOnly . :false))))
          (buffer (stringbed-builder--open-result connection
                    `((spec . ,(stringbed-builder-test--spec)) (forms . ,(stringbed-builder-test--forms)) (editable . t)))))
     (unwind-protect
         (with-current-buffer buffer ,@body)
       (when (buffer-live-p buffer)
         (with-current-buffer buffer (set-buffer-modified-p nil) (setq stringbed--form-dirty nil))
         (kill-buffer buffer)))))
(defun stringbed-builder-test--change (key raw)
  (vui-flush-sync)
  (let* ((instance (cl-find key (vui-get-component-instances 'stringbed-vui--control stringbed-builder--instance)
                            :key (lambda (instance) (stringbed-vui-input-name (plist-get (vui-instance-props instance) :input))) :test #'equal))
         (props (and instance (vui-instance-props instance))))
    (should instance)
    (funcall (plist-get props :on-change) (stringbed-vui-change (plist-get props :input) raw))
    (vui-flush-sync)))

(ert-deftest stringbed-builder-render-and-stable-row-editing ()
  (stringbed-builder-test--with-buffer
   (should (derived-mode-p 'stringbed-builder-mode))
   (should (string-match-p "Visual module builder" (buffer-string)))
   (stringbed-builder-add-parameter)
   (stringbed-builder-add-parameter)
   (let* ((rows (stringbed-builder--rows 'parameters))
          (first (car rows)) (key (stringbed-builder--get first 'uiKey)))
     (stringbed-builder-test--change (concat key "-name") "enabled")
     (stringbed-builder-test--change (concat key "-default") :false)
     (stringbed-builder--move 'parameters key 1)
     (should (equal "enabled" (stringbed-builder--get (cadr (stringbed-builder--rows 'parameters)) 'name)))
     (should (eq :false (stringbed-builder--get (cadr (stringbed-builder--rows 'parameters)) 'default)))
     (should (string-match-p "enabled" (buffer-string)))
     (stringbed-builder--remove 'parameters key)
     (should (= 1 (length (stringbed-builder--rows 'parameters))))
     (should-not (gethash (concat key "-name") stringbed-builder--inputs)))
   (should stringbed--form-dirty)))

(ert-deftest stringbed-builder-preserves-arbitrary-json-keys ()
  (stringbed-builder-test--with-buffer
   (let* ((literal '((uiKey . "retain") (nested . ((uiControl . 42)))))
          (spec (stringbed-builder-test--spec)))
     (setf (alist-get 'parameters spec)
           (vector `((name . "data") (type . "value") (default . ,literal) (description . ""))))
     (setf (alist-get 'assignments spec)
           (vector `((path . "environment.etc") (value . ((literal . ,literal))))))
     (stringbed-builder--initialize-spec spec)
     (let ((clean (stringbed-builder--snapshot)))
       (should (equal literal (stringbed-builder--get (aref (stringbed-builder--get clean 'parameters) 0) 'default)))
       (should (equal literal (stringbed-builder--get (stringbed-builder--get (aref (stringbed-builder--get clean 'assignments) 0) 'value) 'literal)))
       (should-not (assq 'uiKey (aref (stringbed-builder--get clean 'parameters) 0)))))))

(ert-deftest stringbed-builder-invalid-text-cannot-submit-old-value ()
  (stringbed-builder-test--with-buffer
   (stringbed-builder-add-assignment)
   (let* ((row (car (stringbed-builder--rows 'assignments))) (key (stringbed-builder--get row 'uiKey)))
     (stringbed-builder-test--change (concat key "-path") "programs.git.enable")
     (stringbed-builder-test--change (concat key "-value-literal") "false")
     (should (eq :false (stringbed-builder--get (stringbed-builder--get row 'value) 'literal)))
     (stringbed-builder-test--change (concat key "-value-literal") "{broken")
     (should-error (stringbed-builder--snapshot) :type 'user-error)
     (should (string-match-p "valid JSON" (buffer-string)))
     (stringbed-builder--remove 'assignments key)
     (should (stringbed-builder--snapshot)))))

(ert-deftest stringbed-builder-forget-respects-row-boundaries ()
  (stringbed-builder-test--with-buffer
   (puthash "parameter-1-default" :one stringbed-builder--inputs)
   (puthash "parameter-10-default" :ten stringbed-builder--inputs)
   (stringbed-builder--forget "parameter-1")
   (should-not (gethash "parameter-1-default" stringbed-builder--inputs))
   (should (eq :ten (gethash "parameter-10-default" stringbed-builder--inputs)))
   (remhash "parameter-10-default" stringbed-builder--inputs)))

(ert-deftest stringbed-builder-option-picker-retains-control ()
  (stringbed-builder-test--with-buffer
   (stringbed-builder-add-assignment)
   (let ((row (car (stringbed-builder--rows 'assignments))))
     (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "git"))
               ((symbol-function 'completing-read) (lambda (&rest _) "programs.git.enable"))
               ((symbol-function 'stringbed-builder--rpc)
                (lambda (_ params callback &optional _mutation)
                  (should (equal "home" (stringbed--get params 'scope)))
                  (funcall callback '((items . [((path . "programs.git.enable") (control . ((kind . "boolean"))))])) nil))))
       (stringbed-builder--find-option row))
     (vui-flush-sync)
     (should (equal "programs.git.enable" (stringbed-builder--get row 'path)))
     (should (equal '((kind . "boolean")) (stringbed-builder--get row 'uiControl)))
     (should (string-match-p "Choose true or false" (buffer-string))))))

(ert-deftest stringbed-builder-composition-selects-real-form-and-fields ()
  (stringbed-builder-test--with-buffer
   (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "package")))
     (stringbed-builder-add-composition))
   (let* ((row (car (stringbed-builder--rows 'compositions))) (key (stringbed-builder--get row 'uiKey)))
     (should (equal '((kind . "builtin")) (stringbed-builder--get row 'source)))
     (stringbed-builder-test--change (concat key "-binding-attribute-literal") "git")
     (should (equal "git" (stringbed-builder--get (stringbed-builder--get (stringbed-builder--get row 'bindings) 'attribute) 'literal))))))

(ert-deftest stringbed-builder-repeat-save-sends-revision ()
  (stringbed-builder-test--with-buffer
   (setq stringbed-builder--source-directory "/tmp/builder-working"
         stringbed-builder--source-revision "revision-before")
   (let (seen)
     (cl-letf (((symbol-function 'stringbed-builder--rpc)
                (lambda (method params callback &optional _mutation)
                  (setq seen (cons method params))
                  (funcall callback '((directory . "/tmp/builder-working") (revision . "revision-after") (reviewDigest . "reviewed")) nil))))
       (stringbed-builder-save))
     (should (equal "builder/save" (car seen)))
     (should (equal "revision-before" (stringbed--get (cdr seen) 'expectedRevision)))
     (should (equal "revision-after" stringbed-builder--source-revision)))))

(ert-deftest stringbed-builder-pin-keeps-newer-edits-unpinned ()
  (stringbed-builder-test--with-buffer
   (setq stringbed-builder--saved '((directory . "/tmp/work") (reviewDigest . "reviewed"))
         stringbed-builder--saved-generation 0 stringbed-builder--preview-generation 0 stringbed-builder--preview-revision 0)
   (let (callback)
     (cl-letf (((symbol-function 'stringbed-builder--rpc)
                (lambda (_ _params done &optional mutation) (should mutation) (setq callback done))))
       (stringbed-builder-pin "test-module"))
     (stringbed-builder-add-parameter)
     (funcall callback '((workspace . ((scopes . ["home"])))) nil)
     (should-not stringbed-builder--pinned)
     (should (string-match-p "newer builder edits" stringbed-builder--message)))))

(ert-deftest stringbed-builder-immutable-source-is-read-only ()
  (stringbed-builder-test--with-buffer
   (setq stringbed-builder--source-directory "/immutable/bundle"
         stringbed-builder--source '((locked . t) (path . "/immutable/bundle/main.rkt")))
   (let (visited)
     (cl-letf (((symbol-function 'find-file-other-window) (lambda (&rest _) (ert-fail "Opened immutable code writable")))
               ((symbol-function 'stringbed--visit-source) (lambda (path) (setq visited path))))
       (stringbed-builder-source))
     (should (equal "/immutable/bundle/main.rkt" visited)))))

;;; builder-ui-test.el ends here

(ert-deftest stringbed-builder-preview-renders-wire-definitions ()
  (stringbed-builder-test--with-buffer
   (setq stringbed-builder--preview
         '((definitions . [((kind . "assignment") (path . ["programs" "git" "enable"]) (value . t)
                            (text . "programs.git.enable = true;"))])
           (racket . "#lang racket/base") (validation . "structural-only")
           (nativeValidation . ((state . "type-valid") (message . "Types checked separately from merge assertions.")
                                (results . [((path . "programs.git.enable") (state . "type-valid") (message . "Boolean checked"))]))))
         stringbed-builder--preview-generation 0 stringbed-builder--preview-revision 0)
   (stringbed-builder--refresh)
   (vui-flush-sync)
   (should (string-match-p "programs.git.enable = true" (buffer-string)))
   (should (string-match-p "Native Nix: type-valid" (buffer-string)))
   (should (string-match-p "Boolean checked" (buffer-string)))))

(ert-deftest stringbed-builder-workspace-change-invalidates-preview ()
  (stringbed-builder-test--with-buffer
   (setq stringbed-builder--saved '((directory . "/tmp/work") (reviewDigest . "reviewed"))
         stringbed-builder--saved-generation 0 stringbed-builder--preview-generation 0 stringbed-builder--preview-revision 0)
   (setf (stringbed--connection-revision (stringbed--conn)) 1)
   (cl-letf (((symbol-function 'stringbed-builder--rpc) (lambda (&rest _) (ert-fail "Stale review was pinned"))))
     (stringbed-builder-pin "test-module"))
   (should (string-match-p "Preview and save" stringbed-builder--message))))

(ert-deftest stringbed-builder-null-inspection-is-readable ()
  (let* ((connection (stringbed--make-connection :workspace '((scopes . ["home"]))))
         (buffer (stringbed-builder--open-result connection
                   '((editable . :false) (directory . :null) (revision . :null) (forms . [])
                     (source . ((path . "/builtin.rkt") (locked . :false))) (reason . "Handwritten Racket")))))
    (unwind-protect
        (with-current-buffer buffer
          (should-not stringbed-builder--source-directory)
          (should (string-match-p "Handwritten Racket" (buffer-string)))
          (cl-letf (((symbol-function 'stringbed--visit-source) (lambda (path) (should (equal path "/builtin.rkt")))))
            (stringbed-builder-source)))
      (kill-buffer buffer))))

(ert-deftest stringbed-builder-request-rejection-releases-busy-state ()
  (stringbed-builder-test--with-buffer
   (cl-letf (((symbol-function 'stringbed--request) (lambda (&rest _) (user-error "Backend disconnected"))))
     (should-error (stringbed-builder--rpc "builder/preview" nil #'ignore)))
   (should-not stringbed-builder--busy)
   (should (string-match-p "disconnected" stringbed-builder--message))))

(ert-deftest stringbed-builder-captured-bindings-survive-without-ambient-form ()
  (stringbed-builder-test--with-buffer
   (let ((spec (stringbed-builder-test--spec)))
     (setf (alist-get 'compositions spec)
           [((id . "captured") (kind . "missing-form")
             (source . ((kind . "bundle") (sha256 . "old-revision") (entry . "main.rkt")))
             (bindings . ((port . ((literal . 8080))) (enabled . ((literal . :false))))))])
     (stringbed-builder--initialize-spec spec)
     (setq stringbed-builder--forms
           '(((kind . "missing-form") (source . ((kind . "bundle") (sha256 . "different-revision") (entry . "main.rkt")))
              (fields . [((name . "wrong-field") (type . "string"))]))))
     (stringbed-builder--refresh) (vui-flush-sync)
     (should (string-match-p "port — Captured binding" (buffer-string)))
     (should (string-match-p "enabled — Captured binding" (buffer-string)))
     (should-not (string-match-p "wrong-field" (buffer-string)))
     (let* ((row (car (stringbed-builder--rows 'compositions))) (key (stringbed-builder--get row 'uiKey)))
       (stringbed-builder-test--change (concat key "-binding-port-literal") "9000")
       (should (= 9000 (stringbed-builder--get (stringbed-builder--get (stringbed-builder--get row 'bindings) 'port) 'literal)))))))

(ert-deftest stringbed-builder-late-preview-preserves-new-invalid-binding ()
  (stringbed-builder-test--with-buffer
   (let ((spec (stringbed-builder-test--spec)) callback)
     (setf (alist-get 'compositions spec)
           [((id . "child") (kind . "captured") (source . ((kind . "bundle") (sha256 . "identity") (entry . "main.rkt")))
             (bindings . ((data . ((literal . 1))))))])
     (stringbed-builder--initialize-spec spec)
     (stringbed-builder--refresh) (vui-flush-sync)
     (cl-letf (((symbol-function 'stringbed-builder--rpc) (lambda (_ _params done &optional _mutation) (setq callback done))))
       (stringbed-builder-preview))
     (let* ((row (car (stringbed-builder--rows 'compositions))) (key (stringbed-builder--get row 'uiKey)))
       (stringbed-builder-test--change (concat key "-binding-data-literal") "{broken")
       (funcall callback '((forms . []) (definitions . []) (validation . "structural-only")) '((revision . 0)))
       (should (equal "{broken" (stringbed-vui-input-raw (gethash (concat key "-binding-data-literal") stringbed-builder--inputs))))
       (should-error (stringbed-builder--snapshot) :type 'user-error)))))

(ert-deftest stringbed-builder-late-identity-refresh-preserves-new-draft ()
  (stringbed-builder-test--with-buffer
   (let (callback)
     (cl-letf (((symbol-function 'stringbed-builder--rpc) (lambda (_ _params done &optional _mutation) (setq callback done))))
       (stringbed-builder-refresh-builtins))
     (stringbed-builder-test--change "kind" "newer-draft")
     (funcall callback `((spec . ,(stringbed-builder-test--spec))) nil)
     (should (equal "newer-draft" (stringbed-builder--get stringbed-builder--spec 'kind)))
     (should (string-match-p "edits are preserved" stringbed-builder--message)))))

(ert-deftest stringbed-builder-stale-query-releases-busy-state ()
  (stringbed-builder-test--with-buffer
   (let ((connection (stringbed--conn)))
     (cl-letf (((symbol-function 'stringbed--alive-p) (lambda (_) t))
               ((symbol-function 'process-send-string) (lambda (&rest _) nil)))
       (stringbed-builder--rpc "builder/preview" nil (lambda (&rest _) (ert-fail "Stale preview callback ran"))))
     (should stringbed-builder--busy)
     (setf (stringbed--connection-revision connection) 1)
     (stringbed--receive connection '((v . 1) (id . 1) (session . nil) (revision . 0) (result . ((definitions . [])))))
     (should-not stringbed-builder--busy))))

(ert-deftest stringbed-builder-closed-pin-view-still-adopts-registry ()
  (stringbed-builder-test--with-buffer
   (let ((connection (stringbed--conn)))
     (cl-letf (((symbol-function 'stringbed--alive-p) (lambda (_) t))
               ((symbol-function 'process-send-string) (lambda (&rest _) nil)))
       (stringbed-builder--rpc "builder/pin" nil #'ignore t))
     (kill-buffer (current-buffer))
     (stringbed--receive connection
                         '((v . 1) (id . 1) (session . nil) (revision . 1)
                           (result . ((workspace . ((name . "updated") (scopes . ["home"])))
                                      (forms . [((kind . "new-form"))])))))
     (should (equal "updated" (stringbed--get (stringbed--connection-workspace connection) 'name)))
     (should (equal "new-form" (stringbed--get (aref (stringbed--connection-forms connection) 0) 'kind))))))
