#lang racket/base
(require rackunit racket/file racket/port racket/runtime-path "../stringbed/model.rkt" "../stringbed/session.rkt" "../stringbed/ui-extension.rkt")
(define-runtime-path api "../stringbed/ui-extension.rkt")
(module+ test
 (define dir (make-temporary-file "ui-plugin~a" 'directory))
 (dynamic-wind void
  (lambda ()
   (define path (build-path dir "workspace.rktd"))
   (call-with-output-file path (lambda (o) (write (new-workspace "ui-test") o)))
   (define s (open-session path)) (define r (load-registry))
   (check-equal? (draft-diff s) "No unsaved changes.")
   (define p (plugin (hash 'search-package (lambda (s r args) (execute! s r (list 'add 'package (car args) (hash 'attribute "ripgrep"))))) (hash) (hash)))
   (dispatch-ui! s r p '(search-package "finder"))
   (check-equal? (length (matching-nodes (session-workspace s) "RIPGREP")) 1)
   (check-true (regexp-match? #rx"[+] node finder" (draft-diff s)))
   (execute! s r '(save))
   (execute! s r '(note "finder" "My note"))
   (check-true (regexp-match? #rx"node finder / note" (draft-diff s)))
   (check-exn #rx"duplicate" (lambda () (merge-plugins (list p p))))
   (check-exn #rx"shadow" (lambda () (merge-plugins (list (plugin (hash 'save void) (hash) (hash))))))
   (check-exn #rx"command list" (lambda () (dispatch-ui! s r p 'invalid)))
   (check-equal? (merge-plugins '()) empty-plugin)
   (define plugin-path (build-path dir "plugin.rkt"))
   (define (write-plugin value)
     (call-with-output-file plugin-path #:exists 'truncate/replace
       (lambda (o)
         (fprintf o "#lang racket/base\n(require (file ~s))\n(provide ui-plugin)\n(define ui-plugin (plugin (hash 'value (lambda (s r args) ~s)) (hash) (hash)))\n" (path->string api) value))))
   (write-plugin "first")
   (check-equal? (dispatch-ui! s r (load-ui-plugins (list plugin-path)) '(value)) "first")
   (write-plugin "second")
   (check-equal? (dispatch-ui! s r (load-ui-plugins (list plugin-path)) '(value)) "second"))
  (lambda () (delete-directory/files dir))))
