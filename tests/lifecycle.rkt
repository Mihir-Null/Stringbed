#lang racket/base
(require rackunit racket/file racket/list racket/string json "../stringbed/operations.rkt" "../stringbed/lifecycle.rkt" "../stringbed/model.rkt")
(define old (string-append "/nix/store/" (make-string 32 #\a) "-old"))
(define new (string-append "/nix/store/" (make-string 32 #\b) "-new"))
(define root (make-temporary-file "lifecycle-~a" 'directory))
(define selected old)
(define active old)
(define calls '())
(define fail? #f)
(define target-locks (make-hash))
(define (locked?) (positive? (hash-count target-locks)))
(define (runner program args)
  (set! calls (cons (cons program args) calls))
  (cond [(member "mkdir" args) (when (hash-ref target-locks (last args) #f) (error 'lock "already locked")) (hash-set! target-locks (last args) #t) ""]
        [(member "rmdir" args) (hash-remove! target-locks (last args)) ""]
        [(and (equal? program "nix") (member "build" args)) new]
        [(equal? program "cat") "1"]
        [(equal? program "readlink") (if (equal? (last args) "/run/current-system") active selected)]
        [(member "--set" args) (set! selected (last args)) ""]
        [(and (equal? program "sudo") (equal? (last args) "switch"))
         (when fail? (error 'transport "SECRET disconnect"))
         (set! active selected) ""]
        [(string-suffix? program "/activate") (set! active selected) ""]
        [else ""]))
(define (fixture name)
  (define dir (build-path root name)) (make-directory dir)
  (define source (build-path dir "workspace.rktd"))
  (display-to-file (workspace-text (new-workspace "fixture" 'nixos)) source)
  (define export (build-path dir "export")) (make-directory export)
  (display-to-file "{}" (build-path export "flake.nix"))
  (display-to-file "{}" (build-path export "flake.lock"))
  (call-with-output-file (build-path export "target.json")
    (lambda (o) (write-json (hash 'schema 1 'target "nixos" 'system "aarch64-linux" 'workspace-sha256 (bytes-digest (string->bytes/utf-8 (workspace-text (read-workspace source))))) o)))
  (values source export (build-path dir "plan.json")))
(dynamic-wind void
 (lambda ()
  (parameterize ([current-runner runner])
   (test-case "build, activation and rollback are independently observed"
    (define-values (source export plan) (fixture "success"))
    (define p (prepare-plan source export plan #:build-host "builder@host"))
    (check-equal? active old)
    (check-true (ormap (lambda (c) (and (member "ssh-ng://builder@host" c) #t)) calls))
    (check-equal? (hash-ref (verify-plan plan) 'plan-id) (hash-ref p 'plan-id))
    (check-exn exn:fail? (lambda () (prepare-plan source export plan)))
    (check-equal? (hash-ref (apply-plan plan) 'state) "activated")
    (check-exn #rx"not awaiting activation" (lambda () (apply-plan plan)))
    (check-false (locked?))
    (delete-file source)
    (check-equal? (hash-ref (rollback-plan plan) 'state) "rolled-back")
    (check-equal? active old))
   (test-case "source identity and generation drift block mutations"
    (define-values (source export plan) (fixture "drift"))
    (prepare-plan source export plan)
    (display-to-file "changed" source #:exists 'truncate)
    (check-exn #rx"source changed" (lambda () (apply-plan plan)))
    (display-to-file (workspace-text (new-workspace "fixture" 'nixos)) source #:exists 'truncate)
    (set! active new)
    (check-exn #rx"generation changed" (lambda () (apply-plan plan)))
    (check-false (locked?))
    (set! active old)
    (define-values (source2 export2 plan2) (fixture "fresh"))
    (prepare-plan source2 export2 plan2)
    (check-equal? (hash-ref (apply-plan plan2) 'state) "activated")
    (rollback-plan plan2)
    (display-to-file "changed" (build-path export "flake.lock") #:exists 'truncate)
    (check-exn #rx"export or lock changed" (lambda () (apply-plan plan))))
   (test-case "activation disconnect records unknown without output"
    (define-values (source export plan) (fixture "disconnect"))
    (prepare-plan source export plan)
    (set! fail? #t)
    (check-exn exn:fail? (lambda () (apply-plan plan)))
    (check-equal? (hash-ref (lifecycle-status plan) 'state) "unknown")
    (check-false (string-contains? (file->string (string-append (path->string plan) ".journal.json")) "SECRET"))
    (check-exn exn:fail? (lambda () (rollback-plan plan)))
    (check-true (locked?))
    (hash-clear! target-locks) ; simulate explicit operator reconciliation of unknown transport
    (set! fail? #f) (set! selected old))
   (test-case "home adapter requires explicit profile and activates generation"
    (define-values (source export plan) (fixture "home"))
    (check-exn #rx"explicit absolute" (lambda () (prepare-plan source export plan #:kind 'home)))
    (call-with-output-file (build-path export "target.json")
      (lambda (o) (write-json (hash 'schema 1 'target "home" 'system "x86_64-linux" 'workspace-sha256 (bytes-digest (string->bytes/utf-8 (workspace-text (read-workspace source))))) o)) #:exists 'truncate)
    (parameterize ([current-runner (lambda (p a) (if (equal? p "cat") "0" (runner p a)))])
      (check-exn #rx"generation version" (lambda () (prepare-plan source export plan #:kind 'home #:home-profile "/tmp/home profile"))))
    (parameterize ([current-runner (lambda (p a) (if (and (equal? p "cat") (string-prefix? (last a) old)) "0" (runner p a)))])
      (check-exn #rx"generation version" (lambda () (prepare-plan source export plan #:kind 'home #:home-profile "/tmp/home profile"))))
    (parameterize ([current-runner (lambda (p a) (if (equal? p "cat") "2" (runner p a)))])
      (prepare-plan source export plan #:kind 'home #:home-profile "/tmp/home profile"))
    (check-equal? (hash-ref (apply-plan plan) 'state) "activated")
    (check-not-false (member (list (string-append new "/activate") "--driver-version" "1") calls))
    (parameterize ([current-runner (lambda (p a) (if (and (equal? p "cat") (string-prefix? (last a) old)) "0" (runner p a)))])
      (check-exn #rx"generation version" (lambda () (rollback-plan plan))))
    (check-false (locked?))
    (check-equal? (hash-ref (lifecycle-status plan) 'state) "activated")
    (check-equal? (hash-ref (rollback-plan plan) 'state) "rolled-back"))
   (test-case "plan edits and export symlinks rejected"
    (define-values (source export plan) (fixture "tamper"))
    (define p (prepare-plan source export plan))
    (file-or-directory-permissions plan #o600)
    (call-with-output-file plan (lambda (o) (write-json (hash-set p 'target "other") o)) #:exists 'truncate)
    (check-exn #rx"changed plan" (lambda () (read-plan plan)))
    (make-file-or-directory-link source (build-path export "link"))
    (check-exn #rx"symlinks" (lambda () (export-digest export)))))
  (test-case "remote target copies separately from build host and verifies via SSH"
   (define-values (source export plan) (fixture "remote"))
   (define remote-generation old)
   (define remote-calls '())
   (parameterize ([current-runner
     (lambda (program args)
      (set! remote-calls (cons (cons program args) remote-calls))
      (cond [(member "mkdir" args) (when (hash-ref target-locks (last args) #f) (error 'lock "already locked")) (hash-set! target-locks (last args) #t) ""]
        [(member "rmdir" args) (hash-remove! target-locks (last args)) ""]
        [(and (equal? program "nix") (member "build" args)) new]
            [(and (equal? program "ssh") (string-contains? (last args) "'readlink'")) remote-generation]
            [(and (equal? program "ssh") (string-contains? (last args) "'--set'")) (set! remote-generation new) ""]
            [else ""]))])
    (prepare-plan source export plan #:target "target@machine" #:build-host "builder@machine")
    (check-equal? (hash-ref (apply-plan plan) 'state) "activated")
    (check-true (ormap (lambda (c) (and (member "build" c) (string-suffix? (last c) "#packages.aarch64-linux.default"))) remote-calls))
    (check-true (ormap (lambda (c) (and (member "copy" c) (member "ssh-ng://target@machine" c) #t)) remote-calls))
    (check-true (ormap (lambda (c) (and (member "build" c) (member "ssh-ng://builder@machine" c) #t)) remote-calls))))
  (test-case "target lock collision and closure preflight block profile mutation"
   (define-values (source export plan) (fixture "lock"))
   (parameterize ([current-runner runner]) (prepare-plan source export plan))
   (define mutated? #f)
   (hash-set! target-locks "/nix/var/nix/profiles/system.stringbed-lock" #t)
   (parameterize ([current-runner
     (lambda (p a)
      (when (member "--set" a) (set! mutated? #t))
      (runner p a))])
    (check-exn #rx"already locked" (lambda () (apply-plan plan))))
   (check-false mutated?)
   (check-true (locked?)) ; acquisition failure must not remove another caller's lock
   (hash-clear! target-locks)
   (parameterize ([current-runner
     (lambda (p a)
      (when (member "--set" a) (set! mutated? #t))
      (if (equal? p "test") (error 'closure "entry missing") (runner p a)))])
    (check-exn #rx"entry missing" (lambda () (apply-plan plan))))
   (check-false mutated?)
   (check-equal? (hash-ref (lifecycle-status plan) 'state) "failed")
   (check-false (locked?)))
  (test-case "wrong adapter is rejected before build"
   (define-values (source export plan) (fixture "adapter"))
   (define called? #f)
   (parameterize ([current-runner (lambda (p a) (set! called? #t) new)])
    (check-exn #rx"activation adapter" (lambda () (prepare-plan source export plan #:kind 'home #:home-profile "/tmp/home"))))
   (check-false called?)
   (call-with-output-file (build-path export "target.json")
     (lambda (o) (write-json (hash 'schema 1 'target "nixos" 'system "x86_64-linux" 'workspace-sha256 "wrong") o)) #:exists 'truncate)
   (parameterize ([current-runner (lambda (p a) (set! called? #t) new)])
    (check-exn #rx"different workspace source" (lambda () (prepare-plan source export plan))))
   (check-false called?))
  (test-case "standalone Darwin build retains explicit target selection"
   (define-values (source export plan) (fixture "darwin"))
   (call-with-output-file (build-path export "target.json")
     (lambda (o) (write-json (hash 'system "aarch64-darwin") o)) #:exists 'truncate)
   (define seen #f)
   (parameterize ([current-runner (lambda (p a) (set! seen a) "")]) (nix-operation 'build export))
   (check-true (string-suffix? (last seen) "#packages.aarch64-darwin.default")))
  (test-case "remote shell arguments are quoted independently"
   (define seen #f)
   (parameterize ([current-runner (lambda (p a) (set! seen (cons p a)) "")])
    (target-command "user@host" "printf" '("%s" "x';$(touch /tmp/evil)")))
   (check-equal? (last seen) "'printf' '%s' 'x'\"'\"';$(touch /tmp/evil)'")
   (check-exn exn:fail? (lambda () (validate-ssh-target "host;evil"))))
  (test-case "bounded process and output policies"
   (parameterize ([current-process-timeout 0.1])
    (check-exn #rx"timed out" (lambda () ((current-runner) "sh" '("-c" "sleep 5"))))))
  (test-case "process failures do not expose secret stderr and output is bounded"
   (check-exn (lambda (e) (and (exn:fail? e) (not (string-contains? (exn-message e) "SECRET"))))
              (lambda () ((current-runner) "sh" '("-c" "printf SECRET >&2; exit 2"))))
   (parameterize ([current-output-limit 3])
    (check-exn #rx"output exceeded" (lambda () ((current-runner) "printf" '("123456"))))))
  (test-case "encrypted metadata excludes contents"
   (define p (build-path root "secret.yaml"))
   (display-to-file "password: ENC[AES256_GCM,data:SECRET]\nsops: {}" p)
   (check-false (string-contains? (format "~s" (encrypted-secret-metadata p)) "SECRET"))))
 (lambda () (delete-directory/files root)))
