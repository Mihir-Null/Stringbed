#lang racket/base
(require rackunit racket/file racket/path racket/port racket/list racket/string racket/runtime-path json
         "../stringbed/module-builder.rkt" "../stringbed/model.rkt" "../stringbed/extension.rkt"
         "../stringbed/session.rkt" "../stringbed/compiler.rkt" "../stringbed/durability.rkt")
(define registry (load-registry))
(define spec
  (hash 'schema 1 'kind "developer-tools" 'description "Tools I use"
        'parameters (list (hash 'name "enabled" 'type "boolean" 'default #t 'description "Enable Git")
                          (hash 'name "package" 'type "attribute" 'default "git" 'description "Package selection"))
        'assignments (list (hash 'path "programs.git.enable" 'value (hash 'parameter "enabled"))
                           (hash 'path '("home" "sessionVariables" "PERSONAL") 'value (hash 'literal "literal${not-code}")))
        'compositions (list (hash 'id "selected-package" 'kind "package" 'source (hash 'kind "builtin")
                                 'bindings (hash 'attribute (hash 'parameter "package"))))
        'note "My reason" 'docs '("https://nix.dev/") 'sources '("https://git-scm.com/docs")))
(define workspace (new-workspace "builder-test"))
(define (has-code code)
  (lambda (e) (and (exn:fail:builder? e) (equal? (exn:fail:builder-code e) code))))
(define (temporary proc)
  (define dir (make-temporary-file "module-builder-test-~a" 'directory))
  (dynamic-wind void (lambda () (proc dir)) (lambda () (delete-directory/files dir))))
(define (expand-loaded root [values (hash)] [w workspace])
  (define descriptors (load-trusted-extension (build-path root "main.rkt")))
  (define d (car descriptors))
  (define params (for/fold ([p (defaults d)]) ([(k v) (in-hash values)]) (hash-set p k v)))
  (validate-node (hash 'kind (form-kind d) 'params params) (make-registry descriptors))
  ((form-expand d) params w))
(define (texts values)
  (map (lambda (v) (if (assignment? v) (list (assignment-path v) (nix-value (assignment-value v))) (nix-import-expression v))) values))
(test-case "schema is typed data with explicit bindings, annotations and no executable values"
  (define normalized (validate-builder-spec spec))
  (check-equal? (hash-ref (car (hash-ref normalized 'assignments)) 'path) '("programs" "git" "enable"))
  (check-equal? (hash-ref normalized 'note) "My reason")
  (check-true (regexp-match? #px"^[0-9a-f]{64}$" (hash-ref normalized 'builtinSha256)))
  (check-equal? (validate-builder-spec normalized) normalized)
  (check-exn (has-code "unknown-field") (lambda () (validate-builder-spec (hash-set spec 'racket "(system \"bad\")"))))
  (check-exn (has-code "invalid-binding")
             (lambda () (validate-builder-spec (hash-set spec 'assignments (list (hash 'path "x.y" 'value (hash 'literal #t 'parameter "enabled")))))))
  (check-exn (has-code "unknown-parameter")
             (lambda () (validate-builder-spec (hash-set spec 'assignments (list (hash 'path "x.y" 'value (hash 'parameter "missing")))))))
  (check-exn (has-code "invalid-value")
             (lambda () (validate-builder-spec (hash-set spec 'assignments (list (hash 'path "x.y" 'value (hash 'literal (nix-expr "builtins.abort \"bad\"")))))))))
(test-case "typed defaults, child binding keys and cycles fail before artifacts exist"
  (temporary
   (lambda (dir)
     (define bad-default (hash-set spec 'parameters (list (hash 'name "enabled" 'type "boolean" 'default 5))))
     (check-exn (has-code "invalid-default") (lambda () (validate-builder-spec bad-default)))
     (define unknown (hash-set spec 'compositions (list (hash 'id "bad" 'kind "package" 'bindings (hash 'unknown (hash 'literal "git"))))))
     (check-exn (has-code "invalid-composition") (lambda () (builder-spec->forms unknown)))
     (check-exn (has-code "invalid-composition") (lambda () (save-builder-bundle! unknown (build-path dir "invalid"))))
     (check-false (directory-exists? (build-path dir "invalid")))
     (check-exn (has-code "composition-cycle")
                (lambda () (validate-builder-spec (hash-set spec 'compositions (list (hash 'id "self" 'kind "developer-tools" 'bindings (hash)))))))
     (check-exn (has-code "invalid-values") (lambda () (builder-expand spec (hash 'enabled 5) workspace registry))))))
(test-case "preview and generated Racket have equivalent expansion without depending on builder runtime"
  (temporary
   (lambda (dir)
     (define root (build-path dir "tools"))
     (define preview (preview-builder spec (hash 'enabled #f 'package "0ad") workspace registry))
     (check-equal? (hash-ref preview 'validation) "structural-only")
     (check-equal? (length (hash-ref preview 'definitions)) 3)
     (check-false (string-contains? (hash-ref preview 'racket) "stringbed/module-builder"))
     (save-builder-bundle! spec root)
     (check-equal? (texts (expand-loaded root (hash 'enabled #f 'package "0ad")))
                   (texts (builder-expand spec (hash 'enabled #f 'package "0ad") workspace registry)))
     (check-equal? (generate-builder-source spec) (generate-builder-source (hash-ref (read-builder-bundle root) 'spec)))
     (check-true (string-contains? (file->string (build-path root "main.rkt")) "stringbed/builtins")))))
(test-case "repeat save preserves resources and backs up the complete prior revision"
  (temporary
   (lambda (dir)
     (define root (build-path dir "tools"))
     (define first (save-builder-bundle! spec root))
     (display-to-file "keep this resource" (build-path root "notes.txt"))
     (check-exn (has-code "stale-builder")
                (lambda () (save-builder-bundle! (hash-set spec 'note "changed") root #:expected-revision (hash-ref first 'revision))))
     (define opened (read-builder-bundle root))
     (define second (save-builder-bundle! (hash-set spec 'note "changed") root #:expected-revision (hash-ref opened 'revision)))
     (check-equal? (file->string (build-path root "notes.txt")) "keep this resource")
     (check-equal? (hash-ref (hash-ref second 'spec) 'note) "changed")
     (check-equal? (hash-ref (read-builder-bundle (hash-ref second 'backupDirectory)) 'revision) (hash-ref opened 'revision))
     (check-exn (has-code "stale-builder")
                (lambda () (save-builder-bundle! spec root #:expected-revision (hash-ref opened 'revision))))
     (check-false (file-exists? (string-append (path->string root) ".builder-recovery.json"))))))
(test-case "manual Racket/spec edits and forged source receipts never get overwritten"
  (temporary
   (lambda (dir)
     (define root (build-path dir "tools"))
     (define first (save-builder-bundle! spec root))
     (define code (build-path root "main.rkt"))
     (display-to-file "\n;; manual edit to keep\n" code #:exists 'append)
     (define manual (file->bytes code))
     (check-exn (has-code "source-drift") (lambda () (read-builder-bundle root)))
     (check-exn (has-code "source-drift") (lambda () (save-builder-bundle! spec root #:expected-revision (hash-ref first 'revision))))
     (define receipt-path (build-path root "builder.lock.json"))
     (define receipt (call-with-input-file receipt-path read-json))
     (call-with-output-file receipt-path (lambda (out) (write-json (hash-set receipt 'sourceSha256 (bytes-digest manual)) out)) #:exists 'truncate)
     (check-exn (has-code "source-drift") (lambda () (read-builder-bundle root)))
     (check-equal? (file->bytes code) manual)
     (define other (build-path dir "spec-edit"))
     (save-builder-bundle! spec other)
     (display-to-file " " (build-path other "builder.json") #:exists 'append)
     (check-exn (has-code "spec-drift") (lambda () (read-builder-bundle other))))))
(test-case "whole declared dependency bundles survive relocation including relative helper files"
  (temporary
   (lambda (dir)
     (define child (build-path dir "child")) (make-directory child)
     (display-to-file "#lang racket/base\n(provide service-name)\n(define service-name \"nginx\")\n" (build-path child "helper.rkt"))
     (display-to-file
      "#lang racket/base\n(require stringbed/extension \"helper.rkt\")\n(provide forms)\n(define forms (list (form 'web \"Web server\" (list (field 'enabled 'boolean #t \"Enable\")) (lambda (p w) (list (assignment (list \"services\" service-name \"enable\") (hash-ref p 'enabled)))))))\n"
      (build-path child "main.rkt"))
     (define sha (hash-ref (bundle-identity child) 'sha256))
     (define r (load-registry (list (build-path child "main.rkt"))))
     (define composed
       (hash-set spec 'compositions
                 (list (hash 'id "web-service" 'kind "web" 'source (hash 'kind "bundle" 'sha256 sha 'entry "main.rkt")
                             'bindings (hash 'enabled (hash 'parameter "enabled"))))))
     (define root (build-path dir "tools"))
     (save-builder-bundle! composed root #:dependencies (hash sha child) #:registry r)
     (delete-directory/files child)
     (check-equal? (texts (expand-loaded root)) (texts (builder-expand composed (hash) workspace r)))
     (check-false (string-contains? (file->string (build-path root "main.rkt")) (path->string dir)))
     (define derivative (build-path dir "derivative"))
     (save-builder-bundle! (hash-set composed 'note "derived") derivative #:source-directory root #:registry r)
     (delete-directory/files root)
     (check-equal? (texts (expand-loaded derivative)) (texts (builder-expand composed (hash) workspace r)))
     (define nested (build-path derivative "dependencies" sha "helper.rkt"))
     (display-to-file "\n; changed" nested #:exists 'append)
     (check-exn (has-code "dependency-drift") (lambda () (read-builder-bundle derivative))))))
(test-case "pinned builder snapshots are inspected as data and changed only through a derivative"
  (temporary
   (lambda (dir)
     (define workspace-path (build-path dir "home.sbd"))
     (display-to-file (workspace-text workspace) workspace-path)
     (define root (build-path dir "tools"))
     (save-builder-bundle! spec root)
     (define record (pin-extension! workspace-path "tools" root "main.rkt"))
     (define snapshot (build-path dir ".stringbed" "extensions" (hash-ref record 'sha256)))
     (define opened (read-builder-bundle snapshot))
     (check-false (hash-ref opened 'editable))
     (check-exn (has-code "immutable-snapshot")
                (lambda () (save-builder-bundle! spec snapshot #:expected-revision (hash-ref opened 'revision))))
     (define derivative (save-builder-bundle! (hash-set spec 'note "working derivative") (build-path dir "working") #:source-directory snapshot))
     (check-true (hash-ref derivative 'editable))
     (check-equal? (hash-ref (hash-ref (read-builder-bundle snapshot) 'spec) 'note) "My reason")
     (check-true (hash-has-key? (load-registry #:workspace workspace-path) 'developer-tools)))))
(test-case "builtins source identity is enforced and recovery receipts stop ambiguous saves"
  (temporary
   (lambda (dir)
     (define stale (hash-set (validate-builder-spec spec) 'builtinSha256 (make-string 64 #\0)))
     (check-exn (has-code "builtin-drift") (lambda () (builder-spec->forms stale)))
     (define guard-file (build-path dir "stale.rkt"))
     (display-to-file (generate-builder-source stale) guard-file)
     (check-exn #rx"Built-in forms changed" (lambda () (load-trusted-extension guard-file)))
     (define root (build-path dir "tools"))
     (define saved (save-builder-bundle! spec root))
     (display-to-file "{}" (string-append (path->string root) ".builder-recovery.json"))
     (check-exn (has-code "recovery-required")
                (lambda () (save-builder-bundle! spec root #:expected-revision (hash-ref saved 'revision))))
     (check-equal? (hash-ref (read-builder-bundle root) 'revision) (hash-ref saved 'revision)))))

(test-case "explicit builtin refresh changes only its direct identity; ambiguous composed sources are refused"
  (define stale (hash-set (validate-builder-spec spec) 'builtinSha256 (make-string 64 #\0)))
  (define refreshed (refresh-builder-builtins stale))
  (check-not-equal? (hash-ref refreshed 'builtinSha256) (hash-ref stale 'builtinSha256))
  (check-equal? (hash-remove refreshed 'builtinSha256) (hash-remove stale 'builtinSha256))
  (check-equal? (length (builder-spec->forms refreshed)) 1)
  (define external (hash 'kind "bundle" 'sha256 (make-string 64 #\a) 'entry "main.rkt"))
  (define ambiguous
    (hash-set spec 'compositions
              (list (hash 'id "first" 'kind "web" 'source external 'bindings (hash))
                    (hash 'id "second" 'kind "web" 'source (hash-set external 'sha256 (make-string 64 #\b)) 'bindings (hash)))))
  (check-exn (has-code "ambiguous-composition") (lambda () (validate-builder-spec ambiguous))))
