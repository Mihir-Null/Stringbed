(ert-deftest stringbed-stale-and-disconnected-requests-have-terminal-errors ()
  (let ((connection (stringbed--make-connection :session "current" :revision 3)) codes)
    (dolist (case '((1 "current" 2 "stale-result") (2 "old" 3 "wrong-session")))
      (puthash (car case) (list :method "forms" :buffer (current-buffer)
                               :on-error (lambda (error) (push (stringbed--get error 'code) codes)))
               (stringbed--connection-pending connection))
      (stringbed--receive connection `((v . 1) (id . ,(car case)) (session . ,(nth 1 case)) (revision . ,(nth 2 case)) (result . [])))
      (should (equal (nth 3 case) (car codes))))
    (puthash 3 (list :method "edit" :buffer (current-buffer)
                    :on-error (lambda (error) (push (stringbed--get error 'code) codes)))
             (stringbed--connection-pending connection))
    (setf (stringbed--connection-mutation connection) 3)
    (stringbed--fail-pending connection '((code . "disconnected") (message . "Disconnected")))
    (should (equal "disconnected" (car codes)))
    (should (= 0 (hash-table-count (stringbed--connection-pending connection))))
    (should-not (stringbed--connection-mutation connection))))

(ert-deftest stringbed-send-failure-cleans-registered-request ()
  (let ((connection (stringbed--make-connection :session "token")))
    (cl-letf (((symbol-function 'stringbed--alive-p) (lambda (_) t))
              ((symbol-function 'process-send-string) (lambda (&rest _) (error "Disconnected while sending"))))
      (should-error (stringbed--request connection "edit" nil #'ignore t))
      (should (= 0 (hash-table-count (stringbed--connection-pending connection))))
      (should-not (stringbed--connection-mutation connection)))))

(ert-deftest stringbed-closed-editor-mutation-still-updates-shared-snapshot ()
  (let ((origin (generate-new-buffer " *Closed Stringbed editor*"))
        (connection (stringbed--make-connection)) callback after-close done)
    (unwind-protect
        (progn
          (with-current-buffer origin
            (setq stringbed--connection connection)
            (cl-letf (((symbol-function 'stringbed--request)
                       (lambda (_ _ _ success _ _error allow-close)
                         (setq callback success after-close allow-close))))
              (stringbed--mutate "note" '((node . "example") (text . "saved draft")) (lambda (&rest _) (setq done t)))))
          (kill-buffer origin)
          (should after-close)
          (funcall callback '((name . "changed") (nodes . [])) nil)
          (should (equal "changed" (stringbed--get (stringbed--connection-workspace connection) 'name)))
          (should-not done))
      (when (buffer-live-p origin) (kill-buffer origin)))))
