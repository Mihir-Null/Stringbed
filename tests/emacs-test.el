;;; emacs-test.el --- Stringbed presentation contracts -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'stringbed)

(defun stringbed-test--view (&optional dirty)
  `((path . "/tmp/example.sbd") (name . "test") (target . "home") (system . "x86_64-linux")
    (dirty . ,(if dirty t :false)) (readOnly . :false) (scopes . ["home"])
    (nodes . [((id . "existing-id") (kind . "package") (displayName . "Git") (scope . "home")
               (params . ((attribute . "git"))) (note . "Version control") (docs . []) (valid . t))])
    (diagnostics . [])))

(ert-deftest stringbed-json-preserves-values ()
  (dolist (text '("[]" "{}" "[[]]" "[[1,2],[3,4]]" "[{},null,false,true,0,1.5]" "{\"nested\":[[],{}]}"))
    (should (equal text (stringbed--json (stringbed--parse text))))))

(ert-deftest stringbed-tree-renders-and-retains-identity ()
  (with-temp-buffer
    (stringbed-mode)
    (let ((connection (stringbed--make-connection :workspace (stringbed-test--view) :root (current-buffer))))
      (stringbed--attach connection)
      (stringbed--render)
      (should (string-match-p "Git" (buffer-string)))
      (search-forward "  package")
      (should (equal "existing-id" (stringbed--node-at-point)))
      (setf (stringbed--connection-workspace connection) (stringbed--parse (stringbed--json (stringbed-test--view t))))
      (stringbed--render)
      (should (equal "existing-id" (stringbed--node-at-point)))
      (should (string-match-p "unsaved" (buffer-string)))
      (should (equal "git" (stringbed--get (stringbed--get (stringbed--node) 'params) 'attribute))))))

(ert-deftest stringbed-typed-fields-retain-native-values ()
  (with-temp-buffer
    (stringbed-form-mode)
    (let ((boolean (stringbed--field "enabled" '((kind . "boolean")) :false ""))
          (integer (stringbed--field "depth" '((kind . "integer")) 5 ""))
          (nested (stringbed--field "list" '((kind . "list")) [[] []] ""))
          (null (stringbed--field "nullable" '((kind . "nullable")) :null "")))
      (should (eq :false (stringbed--field-value boolean)))
      (setq boolean (stringbed-vui-change boolean t))
      (should (eq t (stringbed--field-value boolean)))
      (should (= 5 (stringbed--field-value integer)))
      (should (equal [[] []] (stringbed--field-value nested)))
      (should (eq :null (stringbed--field-value null)))
      (setq integer (stringbed-vui-change integer "not a number"))
      (should-error (stringbed--field-value integer) :type 'user-error))))

(ert-deftest stringbed-form-stale-revision-cannot-overwrite ()
  (with-temp-buffer
    (stringbed-form-mode)
    (let ((connection (stringbed--make-connection :revision 4)) submitted)
      (stringbed--attach connection)
      (stringbed--field "value" '((kind . "integer")) 4 "")
      (stringbed--finish-form (lambda (_) (setq submitted t)))
      (setf (stringbed--connection-revision connection) 5)
      (stringbed-form-submit)
      (should-not submitted)
      (should (string-match-p "form is stale" (buffer-string))))))

(ert-deftest stringbed-replies-correlate-and-drop-stale-results ()
  (let* ((connection (stringbed--make-connection :session "token" :revision 3)) (pending (stringbed--connection-pending connection)) received)
    (puthash 9 (list :revision 2 :method "package-search" :buffer (current-buffer) :callback (lambda (&rest _) (setq received t))) pending)
    (stringbed--receive connection '((v . 1) (id . 9) (session . "token") (revision . 2) (result . [])))
    (should-not received)
    (should (= 0 (hash-table-count pending)))
    (puthash 10 (list :revision 3 :method "forms" :buffer (current-buffer) :callback (lambda (&rest _) (setq received t))) pending)
    (stringbed--receive connection '((v . 1) (id . 10) (session . "token") (revision . 3) (event . "progress") (message . "Loading")))
    (should (= 1 (hash-table-count pending)))
    (should (equal "Loading" (stringbed--connection-status connection)))
    (stringbed--receive connection '((v . 1) (id . 10) (session . "token") (revision . 3) (result . [])))
    (should received)))

(ert-deftest stringbed-catalog-does-not-repaint-newer-search ()
  (let ((buffer (generate-new-buffer " *catalog test*")) requests)
    (unwind-protect
        (with-temp-buffer
          (setq stringbed--connection (stringbed--make-connection))
          (cl-letf (((symbol-function 'stringbed--request)
                     (lambda (_ method params callback &rest _) (push (list method params callback) requests)))
                    ((symbol-function 'pop-to-buffer) #'ignore))
            (stringbed--catalog-search "package" "old" "home" buffer)
            (stringbed--catalog-search "package" "new" "home" buffer)
            (funcall (nth 2 (car requests)) '((items . [((attribute . "new") (description . "New") (version . "1"))])) nil)
            (funcall (nth 2 (cadr requests)) '((items . [((attribute . "old") (description . "Old") (version . "1"))])) nil)
            (with-current-buffer buffer
              (should (equal "new" (caar tabulated-list-entries)))
              (should-not (string-match-p "Old" (buffer-string))))))
      (kill-buffer buffer))))

(ert-deftest stringbed-package-inspection-enriches-broad-result ()
  (with-temp-buffer
    (stringbed-catalog-mode)
    (setq stringbed--connection (stringbed--make-connection)
          stringbed--catalog-kind "package" stringbed--catalog-scope "home"
          stringbed--catalog-items '(((attribute . "git") (description . "Version control"))))
    (let (requested rendered)
      (let ((inhibit-read-only t)) (insert (propertize "git" 'tabulated-list-id "git")))
      (goto-char (point-min))
      (cl-letf (((symbol-function 'stringbed--request)
                 (lambda (_ method params callback &rest _)
                   (setq requested (list method params))
                   (funcall callback '((items . [((attribute . "git") (homepage . ["https://git-scm.com"]) (position . "/nix/git.nix:3"))])) nil)))
                ((symbol-function 'stringbed--package-detail) (lambda (_ item _) (setq rendered item))))
        (stringbed-catalog-inspect)
        (should (equal "package-search" (car requested)))
        (should (equal "exact" (stringbed--get (cadr requested) 'mode)))
        (should (equal "/nix/git.nix:3" (stringbed--get rendered 'position)))))))

(ert-deftest stringbed-error-stays-with-field ()
  (with-temp-buffer
    (stringbed-form-mode)
    (stringbed--attach (stringbed--make-connection))
    (let ((field (stringbed--field "value" '((kind . "boolean")) t "")))
      (stringbed--finish-form #'ignore)
      (stringbed--form-error '((field . "value") (message . "Option expects a boolean")))
      (should (string-match-p "Option expects a boolean" (buffer-string)))
      (should (equal "value" (vui-key-at))))))

(ert-deftest stringbed-source-navigation-is-read-only ()
  (let ((path (make-temp-file "stringbed-source-" nil ".rkt" "#lang racket/base\n42\n")) buffer)
    (unwind-protect
        (progn
          (stringbed--visit-source (concat path ":2"))
          (setq buffer (current-buffer))
          (should buffer-read-only)
          (should (= (line-number-at-pos) 2)))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-file path))))

(ert-deftest stringbed-dirty-draft-and-pending-edit-prompt-before-loss ()
  (with-temp-buffer
    (setq stringbed--connection (stringbed--make-connection :workspace (stringbed-test--view t)))
    (let ((asked 0))
      (cl-letf (((symbol-function 'y-or-n-p) (lambda (_) (cl-incf asked) nil)))
        (should-not (stringbed--confirm-close))
        (setf (stringbed--connection-workspace stringbed--connection) (stringbed-test--view)
              (stringbed--connection-mutation stringbed--connection) 2)
        (should-not (stringbed--confirm-close))
        (setf (stringbed--connection-mutation stringbed--connection) nil)
        (should (stringbed--confirm-close))
        (should (= 2 asked))))))

(ert-deftest stringbed-old-invalid-boolean-is-not-silently-coerced ()
