(defconst stringbed-test--root
  (file-name-directory (directory-file-name (file-name-directory (or load-file-name buffer-file-name)))))
(defun stringbed-test--wait (predicate process)
  (let ((deadline (+ (float-time) 15)))
    (while (and (not (funcall predicate)) (process-live-p process) (< (float-time) deadline)) (accept-process-output process 0.05))
    (unless (funcall predicate)
      (ert-fail (format "Backend did not respond (%s): %s" (process-status process)
                        (mapconcat (lambda (buffer) (with-current-buffer buffer (buffer-string)))
                                   (cl-remove-if-not (lambda (buffer) (string-prefix-p " *Stringbed diagnostics" (buffer-name buffer))) (buffer-list)) "\n"))))))
(defun stringbed-test--call (connection method params &optional mutation)
  (let (done result failure)
    (stringbed--request connection method params
                        (lambda (value _) (setq result value done t)) mutation
                        (lambda (error) (setq failure error done t)))
    (stringbed-test--wait (lambda () done) (stringbed--connection-process connection))
    (when failure (ert-fail failure)) result))

(ert-deftest stringbed-real-backend-note-save-reopen-undo ()
  (let* ((racket (or (getenv "STRINGBED_RACKET") (executable-find "racket")))
         (directory (make-temp-file "stringbed-emacs-" t))
         (path (expand-file-name "home.sbd" directory)) buffers)
    (skip-unless racket)
    (unwind-protect
        (let ((stringbed-command (list racket (expand-file-name "stringbed/main.rkt" stringbed-test--root) "serve")))
          (copy-file (expand-file-name "examples/home.sbd" stringbed-test--root) path)
          (let* ((buffer (stringbed-open path))
                 (conn (buffer-local-value 'stringbed--connection buffer)))
            (push buffer buffers)
            (with-current-buffer buffer (magit-section-post-command-hook))
            (stringbed-test--wait (lambda () (stringbed--connection-workspace conn)) (stringbed--connection-process conn))
            (with-current-buffer buffer
              (let* ((view (stringbed--connection-workspace conn))
                     (node (elt (stringbed--get view 'nodes) 0))
                     (id (stringbed--get node 'id))
                     (old-note (stringbed--get node 'note))
                     (new-note "Personal note with \"quotes\" and\na second line"))
                (stringbed--accept-view conn (stringbed-test--call conn "note" `((node . ,id) (text . ,new-note)) t))
                (should (stringbed--true-p (stringbed--get (stringbed--connection-workspace conn) 'dirty)))
                (let ((diff (stringbed-test--call conn "diff" nil))) (should (> (length (stringbed--get diff 'changes)) 0)))
                (let ((preview (stringbed-test--call conn "nix" `((node . ,id)))))
                  (should (string-match-p (regexp-quote id) (stringbed--get preview 'text))))
                (stringbed--accept-view conn (stringbed-test--call conn "save" nil t))
                (should-not (stringbed--true-p (stringbed--get (stringbed--connection-workspace conn) 'dirty)))
                (kill-buffer buffer)
                (setq buffer (stringbed-open path) conn (buffer-local-value 'stringbed--connection buffer))
                (push buffer buffers)
                (stringbed-test--wait (lambda () (stringbed--connection-workspace conn)) (stringbed--connection-process conn))
                (with-current-buffer buffer
                  (should (equal new-note (stringbed--get (elt (stringbed--get (stringbed--connection-workspace conn) 'nodes) 0) 'note)))
                  (stringbed--accept-view conn (stringbed-test--call conn "undo" nil t))
                  (should (equal old-note (stringbed--get (elt (stringbed--get (stringbed--connection-workspace conn) 'nodes) 0) 'note))))))))
      (dolist (buffer buffers)
        (when (buffer-live-p buffer) (with-current-buffer buffer (let ((kill-buffer-query-functions nil)) (kill-buffer)))))
      (delete-directory directory t))))

(ert-deftest stringbed-create-form-closes-after-success ()
  (let* ((root (generate-new-buffer " *Stringbed creation test*"))
         (connection (stringbed--make-connection :root root)) form-buffer calls)
    (unwind-protect
        (cl-letf (((symbol-function 'pop-to-buffer) (lambda (buffer &rest _) (setq form-buffer buffer)))
                  ((symbol-function 'stringbed--mutate)
                   (lambda (_method _params done &rest _)
                     (push t calls) (funcall done '((selectedId . "new-option-1")) nil))))
          (stringbed--option-form connection '((path . "test.enable") (type . "boolean")
                                              (description . "A test option") (control . ((kind . "boolean")))
                                              (default . :false) (declarations . [])) "home")
          (let ((creation-buffer form-buffer))
            (with-current-buffer creation-buffer (stringbed-form-submit))
            (should-not (buffer-live-p creation-buffer))
            (should (eq root form-buffer))
            (should (= 1 (length calls)))))
      (when (buffer-live-p form-buffer) (kill-buffer form-buffer))
      (when (buffer-live-p root) (kill-buffer root)))))

(ert-deftest stringbed-change-review-shows-before-and-after-values ()
  (let (review-buffer)
    (unwind-protect
        (with-temp-buffer
          (setq stringbed--connection (stringbed--make-connection))
          (cl-letf (((symbol-function 'pop-to-buffer) (lambda (buffer &rest _) (setq review-buffer buffer)))
                    ((symbol-function 'stringbed--request)
                     (lambda (_ _ _ callback &rest _)
                       (funcall callback '((text . "Changed one entry")
                                           (changes . [((id . "option-1") (label . "feature") (status . "changed")
                                                        (before . ((params . ((value . :false))) (note . "Old reason")))
                                                        (after . ((params . ((value . t))) (note . "New reason"))))])) nil))))
            (stringbed-diff)
            (with-current-buffer review-buffer
              (should (string-match-p "Before" (buffer-string)))
              (should (string-match-p "After" (buffer-string)))
              (should (string-match-p "value: false" (buffer-string)))
              (should (string-match-p "value: true" (buffer-string)))
              (should (string-match-p "Old reason" (buffer-string)))
              (should (string-match-p "New reason" (buffer-string))))))
      (when (buffer-live-p review-buffer) (kill-buffer review-buffer)))))

