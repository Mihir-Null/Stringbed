(ert-deftest stringbed-invalid-old-string-value-is-preserved-for-validation ()
  (with-temp-buffer
    (stringbed-form-mode)
    (let ((field (stringbed--field "value" '((kind . "string")) 5 "string")))
      (setq stringbed--connection (stringbed--make-connection))
      (stringbed--finish-form #'ignore)
      (should (string-match-p "existing value is not a string" (buffer-string)))
