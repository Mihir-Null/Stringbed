(ert-deftest stringbed-integrated-scope-completion-uses-strings ()
  (with-temp-buffer
    (setq stringbed--connection (stringbed--make-connection :workspace '((scopes . ["system" "home:alice"]))))
    (cl-letf (((symbol-function 'completing-read)
