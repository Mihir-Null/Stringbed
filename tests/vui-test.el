;;; vui-test.el --- Reactive form behavior -*- lexical-binding: t; -*-
(require 'ert)
(require 'stringbed)

(defmacro stringbed-vui-test--form (fields &rest body)
  (declare (indent 1))
  `(with-temp-buffer
     (stringbed-form-mode)
     (setq stringbed--connection (stringbed--make-connection :revision 4))
     (dolist (field ,fields) (apply #'stringbed--field field))
     (stringbed--finish-form #'ignore)
     (unwind-protect (progn ,@body)
       (setq stringbed--form-dirty nil stringbed--form-pending nil))))
(defun stringbed-vui-test--input (name)
  (cl-find name stringbed--form-inputs :key #'stringbed-vui-input-name :test #'equal))
(defun stringbed-vui-test--type (name text)
  "Edit the rendered native text field through its real buffer hooks."
  (should (vui-goto-key name))
  (let ((length (length (vui-field-value name))))
    (delete-region (point) (+ (point) length)))
  (insert text)
  (vui-flush-sync))

(ert-deftest stringbed-vui-invalid-text-blocks-last-valid-submission ()
  (stringbed-vui-test--form '(("value" ((kind . "integer")) 12 "An integer"))
    (let (submitted)
      (setq stringbed--form-submit (lambda (values) (setq submitted (gethash "value" values))))
      (stringbed-vui-test--type "value" "12x")
      (should (equal "12x" (vui-field-value "value")))
      (stringbed-form-submit)
      (should-not submitted)
      (should (string-match-p "enter an integer" (buffer-string)))
      (stringbed-vui-test--type "value" "13")
      (stringbed-form-submit)
      (should (= 13 submitted)))))

(ert-deftest stringbed-vui-json-shapes-remain-distinct ()
  (dolist (text '("[]" "{}" "false" "null" "[[],{}]" "1" "\"text\""))
    (let ((input (stringbed-vui-input "value" '((kind . "advanced")) :stringbed-unset)))
      (setq input (stringbed-vui-change input text))
      (should (equal text (stringbed--json (stringbed-vui-input-value input)))))))

(ert-deftest stringbed-vui-nullable-control-preserves-inner-edit ()
  (stringbed-vui-test--form '(("value" ((kind . "nullable") (element . ((kind . "integer")))) 12 "Nullable integer"))
    (vui-goto-key "value/null") (vui-activate) (vui-flush-sync)
    (should (eq :null (stringbed-vui-input-value (stringbed-vui-test--input "value"))))
    (should-not (vui-element-by-key "value"))
    (vui-goto-key "value/null") (vui-activate) (vui-flush-sync)
    (should (equal "12" (vui-field-value "value")))
    (stringbed-vui-test--type "value" "27")
    (vui-goto-key "value/null") (vui-activate) (vui-flush-sync)
    (vui-goto-key "value/null") (vui-activate) (vui-flush-sync)
    (should (= 27 (stringbed-vui-input-value (stringbed-vui-test--input "value"))))))

(ert-deftest stringbed-vui-enum-and-boolean-keep-native-json-values ()
  (stringbed-vui-test--form '(("enabled" ((kind . "boolean")) :false "Flag")
                             ("choice" ((kind . "enum") (choices . [nil :false "small"])) nil "Choice"))
    (vui-goto-key "enabled") (vui-activate) (vui-flush-sync)
    (should (eq t (stringbed-vui-input-value (stringbed-vui-test--input "enabled"))))
    (let ((input (stringbed-vui-test--input "choice")))
      (should (equal "{}" (stringbed--json (stringbed-vui-input-value input))))
      (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "false")))
        (vui-goto-key "choice") (vui-activate) (vui-flush-sync))
      (should (eq :false (stringbed-vui-input-value (stringbed-vui-test--input "choice")))))))

(ert-deftest stringbed-vui-tab-and-backtab-reach-controls-and-fields ()
  (stringbed-vui-test--form '(("text" ((kind . "string")) "hello" "Text")
                             ("flag" ((kind . "boolean")) :false "Flag"))
    (vui-goto-key "text")
    (should (eq #'vui-forward (key-binding (kbd "TAB"))))
    (vui-forward) (should (equal "flag" (vui-key-at)))
    (vui-backward) (should (equal "text" (vui-key-at)))
    (should (eq #'stringbed-form-submit (key-binding (kbd "C-c C-c"))))
    (should (eq #'stringbed-form-close (key-binding (kbd "C-c C-q"))))))

(ert-deftest stringbed-vui-reconciliation-retains-partial-text-point-and-scroll ()
  (let ((buffer (generate-new-buffer " *Stringbed long form*")))
    (unwind-protect
        (save-window-excursion
          (switch-to-buffer buffer)
          (stringbed-form-mode)
          (setq stringbed--connection (stringbed--make-connection :revision 2))
          (dotimes (i 45) (stringbed--field (format "field-%d" i) '((kind . "advanced")) [] "JSON"))
          (stringbed--finish-form #'ignore)
          (stringbed-vui-test--type "field-25" "[1,")
          (vui-goto-key "field-25") (forward-char 2)
          (set-window-start (selected-window) (line-beginning-position -3))
          (let ((key (vui-key-at)) (offset (- (point) (car (vui-element-bounds (vui-field-at)))))
                (start-line (line-number-at-pos (window-start))))
            (setq stringbed--form-pending t)
            (stringbed--form-update)
            (stringbed--form-error '((message . "A backend check failed; your draft is retained")))
            (should (equal "[1," (vui-field-value "field-25")))
            (should (equal key (vui-key-at)))
            (should (= offset (- (point) (car (vui-element-bounds (vui-field-at))))))
            (should (= start-line (line-number-at-pos (window-start))))
            (should (= 45 (length stringbed--form-inputs)))))
      (when (buffer-live-p buffer) (with-current-buffer buffer (setq stringbed--form-dirty nil) (kill-buffer))))))

(ert-deftest stringbed-vui-multiline-note-survives-external-errors ()
  (stringbed-vui-test--form '(("text" ((kind . "string")) "Original" "Note"))
    (stringbed-vui-test--type "text" "First line\nSecond line with \"quotes\"\n")
    (stringbed--form-error '((message . "Input context unavailable")))
    (should (equal "First line\nSecond line with \"quotes\"\n"
                   (stringbed-vui-input-value (stringbed-vui-test--input "text"))))))

(ert-deftest stringbed-vui-form-draft-is-protected-when-root-is-closed ()
  (let ((root (generate-new-buffer " *Stringbed root guard*"))
        (form (generate-new-buffer " *Stringbed form guard*")))
    (unwind-protect
        (let ((connection (stringbed--make-connection :root root :workspace '((dirty . :false)) :buffers (list root form))))
          (with-current-buffer form (setq stringbed--connection connection stringbed--form-dirty t))
          (with-current-buffer root
            (setq stringbed--connection connection)
            (cl-letf (((symbol-function 'y-or-n-p) (lambda (_) nil)))
              (should-not (stringbed--confirm-close)))))
      (kill-buffer form) (kill-buffer root))))

(ert-deftest stringbed-vui-newer-edits-survive-an-earlier-validation-result ()
  (stringbed-vui-test--form '(("value" ((kind . "integer")) 12 "Integer"))
    (let (success failure)
      (cl-letf (((symbol-function 'stringbed--request)
                 (lambda (_ _ _ callback _mutation on-error &rest _) (setq success callback failure on-error))))
        (setq stringbed--form-submit
              (lambda (values) (stringbed--mutate "edit" `((node . "option-1") (values . ,values)) nil #'stringbed--form-error)))
        (stringbed-form-submit)
        (should stringbed--form-pending)
        (stringbed-vui-test--type "value" "14")
        (setf (stringbed--connection-revision stringbed--connection) 5)
        (funcall success '((nodes . [])) nil)
        (should stringbed--form-dirty)
        (should-not stringbed--form-pending)
        (should (= 5 stringbed--form-revision))
        (should (equal "14" (vui-field-value "value")))
        (stringbed-form-submit)
        (stringbed-vui-test--type "value" "15x")
        (funcall failure '((field . "value") (message . "Old value rejected by Nix")))
        (should-not stringbed--form-pending)
        (should (equal "15x" (vui-field-value "value")))
        (should (string-match-p "newer edits are retained" (buffer-string)))
        (should-not (string-match-p "Old value rejected" (buffer-string)))))))

(ert-deftest stringbed-vui-double-submit-keeps-pending-state ()
  (stringbed-vui-test--form '(("text" ((kind . "string")) "Note" ""))
    (let ((calls 0))
      (setq stringbed--form-submit (lambda (_) (cl-incf calls)))
      (stringbed-form-submit)
      (should stringbed--form-pending)
      (should-error (stringbed-form-submit) :type 'user-error)
      (should stringbed--form-pending)
      (should (= 1 calls)))))

(ert-deftest stringbed-vui-enum-labels-distinguish-string-and-boolean ()
  (stringbed-vui-test--form '(("choice" ((kind . "enum") (choices . ["false" :false])) "false" "Mixed enum"))
    (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "false")))
      (vui-goto-key "choice") (vui-activate) (vui-flush-sync))
    (should (eq :false (stringbed-vui-input-value (stringbed-vui-test--input "choice"))))
    (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "\"false\"")))
      (vui-goto-key "choice") (vui-activate) (vui-flush-sync))
    (should (equal "false" (stringbed-vui-input-value (stringbed-vui-test--input "choice"))))))
