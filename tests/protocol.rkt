#lang racket/base
(require rackunit racket/file racket/port racket/path racket/string racket/list racket/runtime-path json
         "../stringbed/protocol.rkt" "../stringbed/model.rkt" "../stringbed/session.rkt"
         "../stringbed/compiler.rkt" "../stringbed/durability.rkt" "../stringbed/operations.rkt")
(define-runtime-path extension-api "../stringbed/extension.rkt")
(define-runtime-path builtins-source "../stringbed/builtins.rkt")
(define (fixture proc [workspace (new-workspace "review")])
  (define dir (make-temporary-file "stringbed-protocol-~a" 'directory))
  (dynamic-wind void
    (lambda ()
      (define path (build-path dir "review.sbd"))
      (display-to-file (string-append "; original layout and comment\n" (workspace-text workspace)) path)
      (define lock (build-path dir "flake.lock"))
      (display-to-file "{\"version\":7,\"nodes\":{}}" lock)
      (proc dir path lock))
    (lambda () (delete-directory/files dir))))
(define (ok reply) (check-false (hash-has-key? reply 'error) (format "~s" reply)) (hash-ref reply 'result))
(define (code reply) (hash-ref (hash-ref reply 'error) 'code))
(define (client b path)
  (define sequence 0)
  (define token #f)
  (define revision 0)
  (define (send method [p (hash)] #:revision [expected revision])
    (set! sequence (add1 sequence))
    (define request (hash 'v 1 'id sequence 'method method 'params p 'session token 'revision expected))
    (define reply (protocol-handle b request))
    (when (hash-has-key? reply 'result)
      (set! token (hash-ref reply 'session)) (set! revision (hash-ref reply 'revision)))
    reply)
  (ok (send "open" (hash 'path (path->string path)))) send)
(define (mock-nix program args)
  (define expr (last args))
  (cond
    [(member "search" args)
     "{\"legacyPackages.x86_64-linux.git\":{\"pname\":\"git\",\"version\":\"2\",\"description\":\"Distributed version control\"}}"]
    [(string-contains? expr "candidate =")
     (if (regexp-match? #rx"candidate = 5;" expr)
         "{\"exists\":true,\"valid\":false}" "{\"exists\":true,\"valid\":true}")]
    [(string-contains? expr "attribute = \"git\"")
     "{\"attribute\":\"git\",\"pname\":\"git\",\"version\":\"2\",\"description\":\"Distributed version control\",\"homepage\":[\"https://git-scm.com\"],\"position\":\"git/default.nix:1\"}"]
    [(string-contains? expr "[ \"programs\" \"git\" \"enable\" ]")
     "{\"path\":\"programs.git.enable\",\"type\":\"boolean\",\"control\":{\"kind\":\"boolean\"},\"description\":\"Enable Git\",\"declarations\":[\"git.nix\"],\"default\":false}"]
    [else "null"]))
(test-case "legacy IDs survive opening; unrelated defaults cannot be inserted"
  (define w (hash-set (new-workspace "review") 'nodes
                     (list (hash 'id "git" 'kind 'package 'params (hash 'attribute "ripgrep") 'note "old note" 'docs '()))))
  (fixture
   (lambda (dir path lock)
     (define original (file->bytes path))
     (define send (client (make-backend) path))
     (define node (car (hash-ref (ok (send "workspace")) 'nodes)))
     (check-equal? (hash-ref node 'id) "git")
     (check-equal? (hash-ref node 'displayName) "ripgrep")
     (check-equal? (file->bytes path) original)
     (define s (open-session path))
     (define r (load-registry))
     (check-exn #rx"explicit selection" (lambda () (execute! s r '(add package "new"))))
     (check-exn #rx"explicit selection" (lambda () (execute! s r '(add option "new"))))
     (check-equal? (session-workspace s) w)) w))
(test-case "selected package, automatic unique IDs, typed option failures, native JSON values"
  (fixture
   (lambda (dir path lock)
     (define send (client (make-backend) path))
     (check-equal? (hash-ref (ok (send "context")) 'state) "needs-lock")
     (check-equal? (hash-ref (ok (send "context" (hash 'lockFile (path->string lock)))) 'state) "ready")
     (parameterize ([current-runner mock-nix])
       (define selected (ok (send "add-package" (hash 'attribute "git" 'scope "home" 'displayName "Version control"))))
       (define id (hash-ref selected 'selectedId))
       (check-equal? (hash-ref (car (hash-ref selected 'nodes)) 'params) (hash 'attribute "git"))
       (define twice (ok (send "add-package" (hash 'attribute "git" 'scope "home"))))
       (check-not-equal? (hash-ref twice 'selectedId) id)
       (define text (hash-ref (ok (send "nix" (hash 'node id))) 'text))
       (check-true (string-contains? text "pkgs.git"))
       (check-false (string-contains? text "pkgs.ripgrep"))
       (check-false (string-contains? text (hash-ref twice 'selectedId)))
       (check-equal? (code (send "add-package" (hash 'attribute "missing"))) "unknown-package")
       (define bad (send "add-option" (hash 'path "programs.git.enable" 'value 5)))
       (check-equal? (code bad) "invalid-option-value")
       (check-equal? (hash-ref (hash-ref bad 'error) 'field) "value")
       (check-equal? (code (send "add-option" (hash 'path "invented.option" 'value #t))) "unknown-option")
       (check-equal? (length (hash-ref (ok (send "workspace")) 'nodes)) 2)
       (define added (ok (send "add-option" (hash 'path "programs.git.enable" 'value #t))))
       (check-equal? (length (hash-ref added 'nodes)) 3)
       (check-true (hash-ref (hash-ref (last (hash-ref added 'nodes)) 'params) 'value))
       (define forms (ok (send "forms")))
       (check-equal? (hash-ref (hash-ref (car forms) 'source) 'path) (path->string (simplify-path builtins-source)))
       (check-true (andmap (lambda (f) (not (hash-ref f 'locked))) forms)))
     (check-equal? (nix-value 'null) "null")
     (check-equal? (nix-value (hash 'ratio 1e20 'tiny -1e-20)) "{ \"ratio\" = 1.0e+20; \"tiny\" = (-1.0e-20); }")
     (check-exn exn:fail? (lambda () (nix-value +nan.0))))))
(test-case "annotations save, exact backups, reopen and durable undo; stale refresh preserves draft"
  (fixture
   (lambda (dir path lock)
     (define original (file->bytes path))
     (define b (make-backend)) (define send (client b path))
     (ok (send "context" (hash 'lockFile (path->string lock))))
     (define id (parameterize ([current-runner mock-nix]) (hash-ref (ok (send "add-package" (hash 'attribute "git"))) 'selectedId)))
     (ok (send "note" (hash 'node id 'text "I use this for code review.")))
     (check-equal? (code (send "note" (hash 'node id 'text "lost") #:revision 0)) "stale-revision")
     (define fresh (ok (send "workspace" #:revision 0)))
     (check-equal? (hash-ref (car (hash-ref fresh 'nodes)) 'note) "I use this for code review.")
     (ok (send "docs" (hash 'node id 'links '("https://git-scm.com/docs"))))
     (define prov (ok (send "provenance" (hash 'node id))))
     (check-equal? (hash-ref (hash-ref prov 'evaluation) 'state) "not-evaluated")
     (check-equal? (hash-ref (hash-ref prov 'authored) 'docs) '("https://git-scm.com/docs"))
     (check-equal? (length (hash-ref (ok (send "diff")) 'changes)) 1)
     (check-false (hash-ref (ok (send "save")) 'dirty))
     (check-equal? (file->bytes (source-backup-path path (bytes-digest original))) original)
     (define reopened (client (make-backend) path))
     (check-true (hash-ref (ok (reopened "workspace")) 'undoAvailable))
     (define after-undo (ok (reopened "undo")))
     (check-equal? (hash-ref (car (hash-ref after-undo 'nodes)) 'docs) '())
     (ok (reopened "save"))
     (check-equal? (hash-ref (car (hash-ref (read-workspace path) 'nodes)) 'note) "I use this for code review.")) ))
(test-case "data-only inspection executes no pinned extension and preserves unknown forms"
  (fixture
   (lambda (dir path lock)
     (define bundle (build-path dir "bundle")) (make-directory bundle)
     (define marker (build-path dir "executed"))
     (display-to-file (format "#lang racket/base\n(call-with-output-file ~s void)\n(provide forms)\n(define forms '())\n" (path->string marker)) (build-path bundle "main.rkt"))
     (pin-extension! path "probe" bundle "main.rkt")
     (define w (add-node (read-workspace path) (hash 'id "opaque" 'kind 'unknown 'params (hash 'data 42) 'note "preserve" 'docs '())))
     (display-to-file (workspace-text w) path #:exists 'truncate)
     (define b (make-backend))
     (define opened (protocol-handle b (hash 'v 1 'id 1 'method "open" 'params (hash 'path (path->string path) 'dataOnly #t))))
     (check-true (hash-ref (ok opened) 'readOnly))
     (check-equal? (hash-ref (car (hash-ref (ok opened) 'nodes)) 'kind) "unknown")
     (check-false (file-exists? marker))
     (define refused (protocol-handle b (hash 'v 1 'id 2 'method "save" 'params (hash) 'session (hash-ref opened 'session) 'revision 0)))
     (check-equal? (code refused) "read-only")
     (check-false (file-exists? marker)))))
(test-case "full workspace remains available during selected preview, diagnostics and provenance"
  (fixture
   (lambda (dir path lock)
     (define extension (build-path dir "peer.rkt"))
     (display-to-file
      (format "#lang racket/base\n(require (file ~s))\n(provide forms)\n(define forms (list (form 'peers \"Count peers\" '() (lambda (p w) (list (assignment '(\"peerCount\") (length (hash-ref w 'nodes))))))))\n" (path->string extension-api)) extension)
     (define w (hash-set (new-workspace "review") 'nodes
                        (for/list ([id '("one" "two")]) (hash 'id id 'kind 'peers 'params (hash) 'note "" 'docs '()))))
     (display-to-file (workspace-text w) path #:exists 'truncate)
     (define send (client (make-backend #:extensions (list extension)) path))
     (check-equal? (hash-ref (ok (send "workspace")) 'diagnostics) '())
     (define text (hash-ref (ok (send "nix" (hash 'node "one"))) 'text))
     (check-true (string-contains? text "peerCount\" = 2"))
     (check-false (string-contains? text "review/two"))
     (define prov (ok (send "provenance" (hash 'node "one"))))
     (check-equal? (hash-ref prov 'definitions) '("\"peerCount\" = 2;"))
     (check-equal? (hash-ref (hash-ref prov 'implementation) 'path) (path->string extension))
     (check-false (hash-ref (findf (lambda (f) (equal? (hash-ref f 'kind) "peers")) (ok (send "forms"))) 'locked)))))
(test-case "previous compatible API lock opens unchanged; unrelated API identity fails"
  (fixture
   (lambda (dir path lock)
     (define bundle (build-path dir "bundle")) (make-directory bundle)
     (display-to-file "#lang racket/base\n(provide forms)\n(define forms '())\n" (build-path bundle "main.rkt"))
     (pin-extension! path "old" bundle "main.rkt")
     (define lp (extension-lock-path path))
     (define data (hash-set (read-extension-lock path) 'api-sha256 "35f0a8fcec9fbddffa65b39896a373b53354d985952ddc892b3deb5738a4ea32"))
     (display-to-file (workspace-text data) lp #:exists 'truncate)
     (define bytes (file->bytes lp))
     (client (make-backend) path)
     (check-equal? (file->bytes lp) bytes)
     (display-to-file (workspace-text (hash-set data 'api-sha256 (make-string 64 #\0))) lp #:exists 'truncate)
     (check-exn #rx"API changed" (lambda () (load-registry #:workspace path))))))

;; Exercise the actual JSONL server over pipes, including correlated responses
;; while an injected slow Nix boundary is in flight.
(define (with-server runner proc)
  (define-values (server-in client-out) (make-pipe))
  (define-values (client-in server-out) (make-pipe))
  (define stderr (open-output-string))
  (define server
    (parameterize ([current-input-port server-in] [current-output-port server-out]
                   [current-error-port stderr] [current-runner runner])
      (thread run-server)))
  (define (send request) (write-json request client-out) (newline client-out) (flush-output client-out))
  (define (receive)
    (unless (sync/timeout 10 client-in) (error 'protocol-test "Timed out: ~a" (get-output-string stderr)))
    (define message (read-json client-in))
    (if (hash-has-key? message 'event) (receive) message))
  (dynamic-wind void (lambda () (proc send receive))
    (lambda ()
      (close-output-port client-out)
      (unless (sync/timeout 5 server) (kill-thread server))
      (close-output-port server-out) (close-input-port server-in) (close-input-port client-in))))
(define (wire id method params [session 'null] [revision 0])
  (hash 'v 1 'id id 'method method 'params params 'session session 'revision revision))
(define wire-workspace
  (hash-set (new-workspace "review") 'nodes
            (list (hash 'id "existing" 'kind 'package 'params (hash 'attribute "ripgrep") 'note "" 'docs '()))))
(test-case "async queries carry captured revisions; later edits cannot be overwritten by slow selection validation"
  (fixture
   (lambda (dir path lock)
     (define started (make-semaphore 0)) (define release (make-semaphore 0))
     (define (runner program args)
       (when (or (member "search" args) (string-contains? (last args) "attribute = \"git\""))
         (semaphore-post started) (semaphore-wait release))
       (mock-nix program args))
     (with-server runner
       (lambda (send receive)
         (send (wire 1 "open" (hash 'path (path->string path))))
         (define opened (receive)) (ok opened) (define token (hash-ref opened 'session))
         (send (wire 2 "context" (hash 'lockFile (path->string lock)) token)) (ok (receive))
         (send (wire 3 "package-search" (hash 'term "version control") token))
         (check-not-false (sync/timeout 10 started))
         (send (wire 4 "note" (hash 'node "existing" 'text "Changed during query") token))
         (define edited (receive)) (ok edited) (check-equal? (hash-ref edited 'id) 4)
         (semaphore-post release)
         (define queried (receive)) (ok queried)
         (check-equal? (hash-ref queried 'id) 3) (check-equal? (hash-ref queried 'revision) 0)
         (send (wire 5 "add-package" (hash 'attribute "git") token 1))
         (check-not-false (sync/timeout 10 started))
         (send (wire 6 "note" (hash 'node "existing" 'text "Newer draft") token 1))
         (check-equal? (hash-ref (receive) 'id) 6)
         (semaphore-post release)
         (define rejected (receive))
         (check-equal? (hash-ref rejected 'id) 5) (check-equal? (code rejected) "stale-revision")
         (send (wire 7 "workspace" (hash) token 0))
         (define current (ok (receive)))
         (check-equal? (length (hash-ref current 'nodes)) 1)
         (check-equal? (hash-ref (car (hash-ref current 'nodes)) 'note) "Newer draft")))) wire-workspace))
(test-case "cancellation validates envelopes, emits one terminal response, and unwinds preparation locks"
  (fixture
   (lambda (dir path lock)
     (define started (make-semaphore 0))
     (define (runner program args)
       (semaphore-post started) (sync never-evt))
     (with-server runner
       (lambda (send receive)
         (send (wire 1 "open" (hash 'path (path->string path))))
         (define opened (receive)) (ok opened) (define token (hash-ref opened 'session))
         (send (wire 2 "context" (hash 'initialize #t) token))
         (check-not-false (sync/timeout 10 started))
         (send (hash-set (wire 3 "cancel" (hash 'request 2) token) 'v 2))
         (check-equal? (code (receive)) "invalid-request")
         (send (wire 4 "cancel" (hash 'request 2) token))
         (define cancelled (receive))
         (check-equal? (hash-ref cancelled 'id) 2) (check-equal? (code cancelled) "cancelled")
         (check-true (hash-ref (ok (receive)) 'cancelled))
         (check-false (directory-exists? (build-path dir ".stringbed" "query" "review.sbd" "prepare.lock")))
         (send (wire 5 "context" (hash 'lockFile (path->string lock)) token))
         (define prepared (receive))
         (check-equal? (hash-ref prepared 'id) 5) (check-equal? (hash-ref (ok prepared) 'state) "ready")
         (send (wire 6 "cancel" (hash 'request 2) token))
         (check-false (hash-ref (ok (receive)) 'cancelled))
         (send (wire 7 "activate" (hash) token))
         (check-equal? (code (receive)) "unknown-method"))))))
(test-case "query completion racing cancellation produces exactly one terminal reply"
  (fixture
   (lambda (dir path lock)
     (with-server mock-nix
       (lambda (send receive)
         (send (wire 1 "open" (hash 'path (path->string path))))
         (define opened (receive)) (ok opened) (define token (hash-ref opened 'session))
         (send (wire 2 "context" (hash 'lockFile (path->string lock)) token)) (ok (receive))
         (for ([iteration (in-range 8)])
           (define query-id (+ 3 (* iteration 3))) (define cancel-id (add1 query-id))
           (define refresh-id (+ query-id 2))
           (send (wire query-id "package-search" (hash 'term (format "term~a" iteration)) token))
           (send (wire cancel-id "cancel" (hash 'request query-id) token))
           (define a (receive)) (define b (receive))
           (check-equal? (sort (list (hash-ref a 'id) (hash-ref b 'id)) <) (list query-id cancel-id))
           (define query (if (= (hash-ref a 'id) query-id) a b))
           (define cancellation (if (= (hash-ref a 'id) cancel-id) a b))
           (if (hash-ref (ok cancellation) 'cancelled)
               (check-equal? (code query) "cancelled") (ok query))
           (send (wire refresh-id "workspace" (hash) token))
           ;; Any duplicate terminal reply would be observed before this barrier.
           (define barrier (receive))
           (check-equal? (hash-ref barrier 'id) refresh-id) (ok barrier)))))))
