(test-case "resubmitting an unchanged legacy invalid value performs native validation"
  (define invalid
    (hash-set (new-workspace "review") 'nodes
              (list (hash 'id "legacy" 'kind 'option 'params (hash 'path "programs.git.enable" 'value 5) 'note "keep" 'docs '()))))
  (fixture
   (lambda (dir path lock)
     (define send (client (make-backend) path))
     (ok (send "context" (hash 'lockFile (path->string lock))))
     (parameterize ([current-runner mock-nix])
       (define rejected (send "edit" (hash 'node "legacy" 'values (hash 'value 5))))
       (check-equal? (code rejected) "invalid-option-value")
       (check-equal? (hash-ref (hash-ref rejected 'error) 'field) "value")
       (define current (ok (send "workspace")))
       (check-false (hash-ref current 'dirty))
       (check-equal? (hash-ref (hash-ref (car (hash-ref current 'nodes)) 'params) 'value) 5))
     (parameterize ([current-runner (lambda _ (error 'test "Label-only changes must not run Nix"))])
       (define renamed (ok (send "edit" (hash 'node "legacy" 'displayName "Needs repair"))))
       (check-equal? (hash-ref (car (hash-ref renamed 'nodes)) 'displayName) "Needs repair"))) invalid))
(test-case "package provenance evaluates the correct shared collection for every scope"
  (for ([target '(home nixos nixos)]
        [scope '("home" "system" "home:alice")]
        [option-path '("home.packages" "environment.systemPackages" "home.packages")]
        [nix-path '("[ \"home\" \"packages\" ]" "[ \"environment\" \"systemPackages\" ]" "[ \"home\" \"packages\" ]")])
    (define w
      (hash-set (new-workspace "review" target) 'nodes
                (list (hash 'id "selected" 'kind 'package 'params (hash 'attribute "git") 'scope scope 'note "" 'docs '()))))
    (when (equal? scope "home:alice")
      (set! w (hash-set w 'homes (hash 'alice (hash 'home-directory "/home/alice" 'state-version "24.11")))))
    (fixture
     (lambda (dir source lock)
       (define send (client (make-backend) source))
       (ok (send "context" (hash 'lockFile (path->string lock))))
       (parameterize ([current-runner
                       (lambda (program args)
                         (define expression (last args))
                         (check-true (string-contains? expression nix-path))
                         (when (equal? scope "home:alice")
                           (check-true (string-contains? expression "getSubOptions"))
                           (check-true (string-contains? expression "home-manager.users.\"alice\"")))
                         (jsexpr->string (hash 'path option-path 'value '("/nix/store/shared-package")
                                              'definitions '() 'definitionsComplete (not (equal? scope "home:alice")))))])
         (define evaluation (hash-ref (ok (send "provenance" (hash 'node "selected" 'evaluated #t))) 'evaluation))
         (check-equal? (hash-ref evaluation 'state) "evaluated")
         (check-equal? (hash-ref evaluation 'subject) (hash 'path option-path 'scope scope 'kind "shared-package-collection"))
         (check-true (string-contains? (hash-ref evaluation 'message) "does not establish"))
         (check-equal? (hash-ref (hash-ref evaluation 'result) 'value) '("/nix/store/shared-package")))) w)))
